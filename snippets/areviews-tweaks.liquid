{%- comment -%}
  Product-page tweaks for the Areviews widget.

  The widget's markup is injected at runtime by areviewsapp.com, so nothing here
  can be done in Liquid — we wait for the widget to render, then adjust it:

    1. Hides the "Be the first to review this item" empty-state line. It has no
       class of its own, so it is matched on its text; add translations to
       EMPTY_STATE_TEXT if the app language changes.
    2. Rewrites the "Customer Reviews" summary — average score, stars and the
       1-5 rating bars — from the values set on the review section (see the
       .areviews-summary-override payload it prints).

  Class names below (.box_rating_container_style2, .box_rating_number, .w3-blue,
  .average_rating, .main_review_stars) are the app's own; sections/areviews-section.liquid
  already styles against them. If an app update renames them the override simply
  stops applying and the widget's real data shows through.
{%- endcomment -%}

<style>
  /* Stars we render ourselves for the summary average, so we don't depend on
     the app's icon font. Grey track with a gold overlay clipped to the score. */
  #az_reviews .theme-avg-stars {
    display: inline-block;
    position: relative;
    line-height: 1;
    white-space: nowrap;
    font-size: 1.4em;
    letter-spacing: 0.12em;
  }
  #az_reviews .theme-avg-stars__base { color: #d8d8d8; }
  #az_reviews .theme-avg-stars__fill {
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;
    color: #f3c621;
  }
</style>

<script>
(function () {
  var EMPTY_STATE_TEXT = ['be the first to review'];
  var ROOT_SELECTOR = '#az_reviews';

  /* ---------------------------------------------------------------- config */

  function readOverride() {
    var el = document.querySelector('.areviews-summary-override');
    if (!el) return null;
    try { return JSON.parse(el.textContent); } catch (e) { return null; }
  }

  /* "Rated 4.8/5 by 1240+ Customers" -> 4.8. Falls back to the first number
     in the string so wordings like "4.8 out of 5" still work. */
  function parseAverage(text) {
    if (!text) return null;
    var m = text.match(/(\d+(?:[.,]\d+)?)\s*\/\s*5/);
    if (!m) m = text.match(/(\d+(?:[.,]\d+)?)/);
    if (!m) return null;
    var n = parseFloat(m[1].replace(',', '.'));
    if (isNaN(n) || n < 0) return null;
    return Math.min(n, 5);
  }

  /* ------------------------------------------------------------ empty state */

  function hideEmptyState(root) {
    var nodes = root.querySelectorAll('a, p, span, div, h1, h2, h3, h4, h5, h6');
    Array.prototype.forEach.call(nodes, function (el) {
      if (el.dataset.areviewsHidden) return;
      var text = (el.textContent || '').trim().toLowerCase();
      if (!text || text.length > 80) return;              /* skip containers */
      var match = EMPTY_STATE_TEXT.some(function (t) { return text.indexOf(t) !== -1; });
      if (!match) return;
      /* Climb to the outermost element whose text is *only* this line, so the
         icon beside it goes too, but never a parent holding other content. */
      var target = el;
      while (
        target.parentElement &&
        target.parentElement !== root &&
        (target.parentElement.textContent || '').trim().toLowerCase() === text
      ) {
        target = target.parentElement;
      }
      target.dataset.areviewsHidden = '1';
      target.style.display = 'none';
    });
  }

  /* --------------------------------------------------------------- summary */

  function starsMarkup(average) {
    var pct = Math.max(0, Math.min(100, (average / 5) * 100));
    return (
      '<span class="theme-avg-stars">' +
        '<span class="theme-avg-stars__base">★★★★★</span>' +
        '<span class="theme-avg-stars__fill" style="width:' + pct + '%">★★★★★</span>' +
      '</span>'
    );
  }

  /* The summary star row has no dependable class of its own, so find it by
     position: the nearest element to the score that groups 5+ icon children.
     Scoped to the score's ancestors so the per-review star rows further down
     the widget are never touched. */
  function findStarHost(scoreEl, root) {
    var scopes = [];
    var node = scoreEl;
    for (var i = 0; i < 4 && node.parentElement && node.parentElement !== root; i++) {
      node = node.parentElement;
      scopes.push(node);
    }

    var STAR_TEXT = /^[\s★☆⭐✩✭✮]+$/;

    for (var s = 0; s < scopes.length; s++) {
      var mine = scopes[s].querySelector('[data-theme-stars]');
      if (mine) return mine;                                   /* already ours */

      var best = null;
      var bestDepth = -1;
      var candidates = scopes[s].querySelectorAll('*');
      for (var c = 0; c < candidates.length; c++) {
        var el = candidates[c];
        if (el.classList.contains('average_rating') || el.querySelector('.average_rating')) continue;

        var text = (el.textContent || '').trim();
        var icons = el.querySelectorAll('i, svg').length;
        /* Either a row of icon elements with no text, or literal star glyphs. */
        var isIconRow = icons >= 5 && text.length === 0;
        var isTextRow = icons === 0 && text.length >= 5 && STAR_TEXT.test(text);
        if (!isIconRow && !isTextRow) continue;

        var depth = 0;
        for (var p = el; p && p !== scopes[s]; p = p.parentElement) depth++;
        if (depth > bestDepth) { best = el; bestDepth = depth; }  /* deepest = the row itself */
      }
      if (best) return best;
    }
    return null;
  }

  function applyAverage(root, average) {
    var box = root.querySelector('.average_rating');
    if (!box) return;
    /* The app renders the score and the "/5" suffix as separate spans. */
    var spans = box.querySelectorAll('span');
    var shown = average.toFixed(1);
    /* Only write when the value actually differs — every text write inside the
       observed root fires the MutationObserver again. */
    var scoreEl = spans.length ? spans[0] : box;
    if ((scoreEl.textContent || '').trim() !== shown) scoreEl.textContent = shown;

    /* Proximity first: a .main_review_stars elsewhere in the widget is not
       necessarily the summary row (that mismatch is why the stars stayed blank). */
    var stars = findStarHost(box, root) || root.querySelector('.main_review_stars');
    if (stars && stars.dataset.themeStars !== shown) {
      stars.dataset.themeStars = shown;
      stars.innerHTML = starsMarkup(average);
    }
  }

  function applyDistribution(root, counts) {
    var container = root.querySelector('.box_rating_container_style2');
    if (!container) return;

    var bars = container.querySelectorAll('.w3-blue');
    var pills = container.querySelectorAll('.box_rating_number');
    /* Rows run 5 stars down to 1; bail out unless the widget looks as expected. */
    if (bars.length !== 5) return;

    var order = ['5', '4', '3', '2', '1'];
    var total = order.reduce(function (sum, k) { return sum + (counts[k] || 0); }, 0);

    order.forEach(function (star, i) {
      var count = counts[star] || 0;
      var pct = total > 0 ? (count / total) * 100 : 0;
      if (bars[i]) bars[i].style.width = pct + '%';
      if (pills[i] && (pills[i].textContent || '').trim() !== String(count)) {
        pills[i].textContent = count;
      }
    });
  }

  function applySummary(root, cfg) {
    if (!cfg) return;
    var average = parseAverage(cfg.subheading);
    if (average !== null) applyAverage(root, average);
    if (cfg.counts) applyDistribution(root, cfg.counts);
  }

  /* ----------------------------------------------------------------- boot */

  function watch() {
    var root = document.querySelector(ROOT_SELECTOR);
    if (!root) return false;
    var cfg = readOverride();

    function run() {
      hideEmptyState(root);
      applySummary(root, cfg);
    }

    run();
    new MutationObserver(run).observe(root, { childList: true, subtree: true });
    return true;
  }

  function start() {
    if (watch()) return;
    /* The widget container is added by the app block after this script runs. */
    var tries = 0;
    var poll = setInterval(function () {
      if (watch() || ++tries > 40) clearInterval(poll);   /* give up after ~20s */
    }, 500);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }
})();
</script>
