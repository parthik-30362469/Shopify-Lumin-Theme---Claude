{%- comment -%} Jack — Smart Solutions Section (clip-path reveal animation) {%- endcomment -%}

<style>
/* ── Section ──────────────────────────────────────────────── */
.jack-solutions {
  background: #ffffff;
  border-radius: 40px 40px 0 0;
  padding: 5rem 1.25rem 6rem;
  font-family: 'Kanit', sans-serif;
  position: relative;
  z-index: 5;
}
@media (min-width: 640px)  { .jack-solutions { border-radius: 50px 50px 0 0; padding: 6rem 2rem 7rem;   } }
@media (min-width: 768px)  { .jack-solutions { border-radius: 60px 60px 0 0; padding: 8rem 2.5rem 8rem; } }

/* ── Heading ──────────────────────────────────────────────── */
.jack-solutions-h2 {
  color: #0C0C0C;
  font-family: 'Kanit', sans-serif;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: -0.03em;
  line-height: 0.95;
  text-align: center;
  font-size: clamp(2.2rem, 6.5vw, 80px);
  margin: 0 0 4rem;
  max-width: 900px;
  margin-left: auto;
  margin-right: auto;
}
@media (min-width: 640px) { .jack-solutions-h2 { margin-bottom: 5rem; } }
@media (min-width: 768px) { .jack-solutions-h2 { margin-bottom: 7rem; } }

/* ── Grid ─────────────────────────────────────────────────── */
.jack-sol-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
  max-width: 72rem;
  margin: 0 auto;
}
@media (min-width: 768px) {
  .jack-sol-grid {
    grid-template-columns: 1fr 1fr;
  }
}

/* ── Divider lines ────────────────────────────────────────── */
.jack-sol-card {
  padding: 2.5rem 0;
  border-top: 1px solid rgba(12,12,12,0.12);
}
@media (min-width: 768px) {
  /* Right-column cards get a left border */
  .jack-sol-card:nth-child(even) {
    padding-left: 3rem;
    border-left: 1px solid rgba(12,12,12,0.12);
  }
  .jack-sol-card:nth-child(odd) {
    padding-right: 3rem;
  }
  /* Remove top border from first two cards */
  .jack-sol-card:nth-child(1),
  .jack-sol-card:nth-child(2) {
    border-top: none;
    padding-top: 0;
  }
  /* Add bottom border to last two */
  .jack-sol-card:nth-child(5),
  .jack-sol-card:nth-child(6) {
    border-bottom: 1px solid rgba(12,12,12,0.12);
    padding-bottom: 2.5rem;
  }
}
@media (max-width: 767px) {
  .jack-sol-card:first-child { border-top: none; padding-top: 0; }
  .jack-sol-card:last-child  { border-bottom: 1px solid rgba(12,12,12,0.12); }
}

/* ── Inner layout (number + text) ────────────────────────── */
.jack-sol-inner {
  display: flex;
  align-items: flex-start;
  gap: 1.25rem;
}
@media (min-width: 640px) { .jack-sol-inner { gap: 1.75rem; } }
@media (min-width: 768px) { .jack-sol-inner { gap: 2rem;    } }

/* ── Number ───────────────────────────────────────────────── */
.jack-sol-num {
  color: #0C0C0C;
  font-family: 'Kanit', sans-serif;
  font-weight: 900;
  font-size: clamp(2.5rem, 7vw, 90px);
  line-height: 1;
  flex-shrink: 0;
  min-width: clamp(2.5rem, 7vw, 90px);
}

/* ── Text ─────────────────────────────────────────────────── */
.jack-sol-content {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  padding-top: 0.2rem;
}

.jack-sol-name {
  color: #0C0C0C;
  font-family: 'Kanit', sans-serif;
  font-weight: 600;
  text-transform: uppercase;
  font-size: clamp(1.05rem, 2.2vw, 2rem);
  line-height: 1.15;
  margin: 0;
}

.jack-sol-desc {
  color: rgba(12,12,12,0.62);
  font-family: 'Kanit', sans-serif;
  font-weight: 300;
  line-height: 1.65;
  font-size: clamp(1rem, 1.8vw, 1.35rem);
  margin: 0;
}

/* ══════════════════════════════════════════════════════════
   CLIP-PATH REVEAL ANIMATION
   Each card starts fully clipped (hidden), then sweeps open
   from bottom to top as it enters the viewport.
   Left-column cards delay = 0s, right-column = 0.12s
   ══════════════════════════════════════════════════════════ */
.jack-sol-card {
  --reveal-delay: 0s;
}
/* Right-column cards (even) stagger 0.12s after left */
.jack-sol-card:nth-child(even) {
  --reveal-delay: 0.12s;
}

.jack-sol-inner {
  clip-path: inset(100% 0 0 0);   /* fully hidden below its own bottom edge */
  transition: clip-path 0.75s cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay),
              opacity    0.75s ease var(--reveal-delay);
  opacity: 0;
  will-change: clip-path, opacity;
}

.jack-sol-card.sol-revealed .jack-sol-inner {
  clip-path: inset(0% 0 0 0);     /* fully visible */
  opacity: 1;
}

/* Also animate the number with a tiny upward translate for extra polish */
.jack-sol-num {
  transform: translateY(12px);
  transition: transform 0.75s cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0s);
}
.jack-sol-card.sol-revealed .jack-sol-num {
  transform: translateY(0);
}
</style>

<section class="jack-solutions" id="jack-services">

  <h2 class="jack-solutions-h2 jfi jfi-dn" data-jfi-delay="0">
    Smart Solutions For Everyday Lifestyle
  </h2>

  <div class="jack-sol-grid">

    <div class="jack-sol-card">
      <div class="jack-sol-inner">
        <span class="jack-sol-num">01</span>
        <div class="jack-sol-content">
          <p class="jack-sol-name">Smart Home</p>
          <p class="jack-sol-desc">Innovative devices designed to simplify daily routines, save time, and make your home more comfortable. From automatic cleaning solutions to intelligent household gadgets, technology that works while you relax.</p>
        </div>
      </div>
    </div>

    <div class="jack-sol-card">
      <div class="jack-sol-inner">
        <span class="jack-sol-num">02</span>
        <div class="jack-sol-content">
          <p class="jack-sol-name">Health &amp; Wellness</p>
          <p class="jack-sol-desc">Smart wellness products that help support recovery, comfort, and self-care. From heated therapy devices to posture aids and wellness technology designed to help you feel your best every day.</p>
        </div>
      </div>
    </div>

    <div class="jack-sol-card">
      <div class="jack-sol-inner">
        <span class="jack-sol-num">03</span>
        <div class="jack-sol-content">
          <p class="jack-sol-name">Beauty &amp; Self-Care</p>
          <p class="jack-sol-desc">Modern beauty tools and skincare technology designed to enhance your daily routine. Innovative solutions that help improve convenience, efficiency, and confidence without expensive salon visits.</p>
        </div>
      </div>
    </div>

    <div class="jack-sol-card">
      <div class="jack-sol-inner">
        <span class="jack-sol-num">04</span>
        <div class="jack-sol-content">
          <p class="jack-sol-name">Pet Essentials</p>
          <p class="jack-sol-desc">Technology-driven pet products that make caring for your furry companions easier and more enjoyable. From automatic feeders to grooming solutions and smart accessories designed for modern pet owners.</p>
        </div>
      </div>
    </div>

    <div class="jack-sol-card">
      <div class="jack-sol-inner">
        <span class="jack-sol-num">05</span>
        <div class="jack-sol-content">
          <p class="jack-sol-name">Baby &amp; Parenting</p>
          <p class="jack-sol-desc">Thoughtfully designed products that help simplify life for parents and provide extra comfort for little ones. Including smart warming solutions, feeding accessories, and everyday parenting essentials.</p>
        </div>
      </div>
    </div>

    <div class="jack-sol-card">
      <div class="jack-sol-inner">
        <span class="jack-sol-num">06</span>
        <div class="jack-sol-content">
          <p class="jack-sol-name">Work &amp; Productivity</p>
          <p class="jack-sol-desc">Practical tech accessories that help create a more comfortable and efficient workspace. From ergonomic solutions to desk gadgets designed to support focus, organisation, and productivity.</p>
        </div>
      </div>
    </div>

  </div>

</section>

<script>
(function () {
  var cards = document.querySelectorAll('.jack-sol-card');
  if (!cards.length) return;

  if (!('IntersectionObserver' in window)) {
    cards.forEach(function (c) { c.classList.add('sol-revealed'); });
    return;
  }

  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('sol-revealed');
        io.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -60px 0px' });

  cards.forEach(function (c) { io.observe(c); });
})();
</script>

