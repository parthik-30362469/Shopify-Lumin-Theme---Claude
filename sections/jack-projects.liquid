<script>
/*
 * Scale-down depth effect on the sticky stacking cards.
 * The STACKING itself is pure CSS (position:sticky + z-index) — this JS
 * only adds the subtle "push back" scale as the next card slides over.
 * If JS fails for any reason, cards still stack correctly via CSS.
 *
 *   targetScale = 1 - (totalCards - 1 - index) * 0.03   (per the brief)
 * eased by each slot's scroll progress through the viewport.
 */
(function () {
  var cards = Array.prototype.slice.call(
    document.querySelectorAll('.jack-projects .jack-card')
  );
  if (!cards.length) return;
  var TOTAL = cards.length;

  function update() {
    /* For each card, scale it down as the NEXT card slides up to cover it.
       progress = how far the next card has travelled toward this card's
       sticky position (0 = far below, 1 = fully covering).               */
    cards.forEach(function (card, i) {
      var next = cards[i + 1];
      if (!next) { card.style.transform = 'scale(1)'; return; }

      var thisTop = card.getBoundingClientRect().top;   /* this card pinned here */
      var nextTop = next.getBoundingClientRect().top;   /* next card sliding up   */
      var gap     = nextTop - thisTop;                  /* shrinks 0 as next covers */

      /* Normalise: when next card is one viewport below → 0; when it
         reaches this card's top → 1 */
      var span     = window.innerHeight * 0.85;
      var progress = Math.max(0, Math.min(1, 1 - gap / span));

      var targetScale = 1 - (TOTAL - 1 - i) * 0.04; /* deeper cards shrink more */
      var scale       = 1 - (1 - targetScale) * progress;

      card.style.transform = 'scale(' + scale + ')';
    });
  }

  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update, { passive: true });
  update();
})();
</script>

