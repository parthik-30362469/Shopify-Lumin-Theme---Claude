{%- comment -%} Jack — Projects: sticky-stacking cards (CSS position:sticky) {%- endcomment -%}

<style>
/* ── Section ──────────────────────────────────────────────── */
.jack-projects {
  background: #0C0C0C;
  border-radius: 40px 40px 0 0;
  margin-top: -2.5rem;
  position: relative;
  z-index: 10;
  padding: 5rem 1.25rem 6rem;
  font-family: 'Kanit', sans-serif;
  /* IMPORTANT: must stay overflow:visible so sticky cards can pin */
}
@media (min-width: 640px) { .jack-projects { border-radius:50px 50px 0 0; margin-top:-3rem;   padding:6rem 2rem 8rem;    } }
@media (min-width: 768px) { .jack-projects { border-radius:60px 60px 0 0; margin-top:-3.5rem; padding:8rem 2.5rem 10rem;  } }

/* ── Heading ──────────────────────────────────────────────── */
.jack-proj-h2 {
  font-family: 'Kanit', sans-serif;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: -0.03em;
  line-height: 1;
  text-align: center;
  font-size: clamp(3rem, 12vw, 160px);
  margin: 0 0 4rem;
}

/* ── Card: each card is a direct sibling and sticks at the same
   region near the top. Because they share a sticky context (the
   section), a later card scrolls up and pins ON TOP of the earlier
   one, which stays put — producing the pile-up / stacking effect.

   `top` is staggered by index*28px (inline) so the top edge of each
   card beneath stays peeking out. z-index increases so newer cards
   paint over older ones. margin-bottom gives scroll distance so each
   card "holds" before the next slides over it.
──────────────────────────────────────────────────────────── */
.jack-card {
  position: sticky;
  top: 6rem;
  border-radius: 32px;
  border: 1px solid rgba(215,226,234,0.14);
  background: #111111;          /* solid — fully covers card below */
  padding: 1.25rem;
  margin-bottom: 14vh;          /* scroll runway between sticks */
  transform-origin: center top;
  will-change: transform;
}
.jack-card:last-child { margin-bottom: 0; }
@media (min-width: 640px) { .jack-card { border-radius:40px; padding:1.5rem; top:7rem; } }
@media (min-width: 768px) { .jack-card { border-radius:50px; padding:2rem;   top:8rem; } }

/* Stacking order + tonal depth so layers read as separate cards */
.jack-card:nth-of-type(1) { z-index: 1; background:#111111; }
.jack-card:nth-of-type(2) { z-index: 2; background:#151515; }
.jack-card:nth-of-type(3) { z-index: 3; background:#191919; }

/* ── Card header ──────────────────────────────────────────── */
.jack-card-top {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.25rem;
  flex-wrap: wrap;
}
.jack-card-num {
  color: #D7E2EA;
  font-family: 'Kanit', sans-serif;
  font-weight: 900;
  font-size: clamp(3rem, 10vw, 140px);
  line-height: 1;
  flex-shrink: 0;
}
.jack-card-meta { display:flex; flex-direction:column; gap:0.2rem; flex:1; }
.jack-card-category {
  color: rgba(215,226,234,0.55);
  font-size: clamp(0.7rem, 1.2vw, 0.95rem);
  font-weight: 300;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}
.jack-card-name {
  color: #D7E2EA;
  font-size: clamp(1rem, 2.2vw, 2rem);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.02em;
}

/* ── CTA button ───────────────────────────────────────────── */
.jack-live-btn {
  display:inline-flex; align-items:center; gap:0.7rem;
  padding:1rem 3rem;
  background:linear-gradient(135deg,#000 0%,#1e1e1e 35%,#5a5a5a 65%,#c8c8c8 100%);
  box-shadow:0 4px 16px rgba(255,255,255,0.12),inset 2px 2px 8px rgba(255,255,255,0.08);
  outline:2px solid rgba(255,255,255,0.7); outline-offset:-3px;
  border-radius:9999px; border:none; color:#fff;
  font-family:'Kanit',sans-serif; font-weight:600;
  text-transform:uppercase; letter-spacing:0.14em;
  font-size:clamp(0.9rem,1.6vw,1.25rem);
  text-decoration:none; cursor:pointer; overflow:hidden;
  position:relative; white-space:nowrap; margin-left:auto;
  animation:jack-float 3s ease-in-out 1s infinite;
}
@media (min-width: 640px) { .jack-live-btn { padding:1.1rem 3.5rem; } }
@media (min-width: 768px) { .jack-live-btn { padding:1.25rem 4rem;  } }
.jack-live-btn:hover { animation-play-state:paused; opacity:0.9; transform:translateY(-3px) scale(1.03); }
.jack-live-btn::before {
  content:''; position:absolute; top:0; left:-75%; width:50%; height:100%;
  background:linear-gradient(105deg,transparent 20%,rgba(255,255,255,0.22) 50%,transparent 80%);
  transform:skewX(-15deg);
}
.jack-live-btn:hover::before { left:130%; transition:left 0.55s ease; }
@keyframes jack-float {
  0%,100% { transform:translateY(0);    box-shadow:0 4px 20px rgba(255,255,255,0.12),inset 2px 2px 8px rgba(255,255,255,0.08); }
  50%     { transform:translateY(-6px); box-shadow:0 12px 36px rgba(255,255,255,0.22),inset 2px 2px 8px rgba(255,255,255,0.12); }
}

/* ── Image grid ───────────────────────────────────────────── */
.jack-card-imgs { display:flex; gap:0.75rem; }
.jack-card-col1 { display:flex; flex-direction:column; gap:0.75rem; width:40%; flex-shrink:0; }
.jack-card-col2 { flex:1; }
.jack-card-col1 img, .jack-card-col2 img {
  width:100%; object-fit:cover; display:block; border-radius:24px;
}
@media (min-width:640px){ .jack-card-col1 img,.jack-card-col2 img { border-radius:32px; } }
@media (min-width:768px){ .jack-card-col1 img,.jack-card-col2 img { border-radius:40px; } }
.jack-card-col1 img:first-child { height:clamp(110px,13vw,180px); }
.jack-card-col1 img:last-child  { height:clamp(140px,18vw,270px); }
.jack-card-col2 img             { height:100%; min-height:clamp(250px,30vw,460px); }
</style>

