{%- comment -%}
  Jack — Best Solutions: sticky-stacking cards.
  Each card shows 3 products picked at random from its collection; the trio
  re-rolls every 10s (see JS at the bottom) so every product gets airtime.
  Fully editable from the theme customizer:
    • Section heading
    • Each card = a "Slide" block with title, collection, button label + link
    • Add / remove / reorder slides freely
{%- endcomment -%}

<style>
/* ── Section ──────────────────────────────────────────────── */
.jack-projects {
  background: #0C0C0C;
  border-radius: 0;
  margin-top: 3rem;
  position: relative;
  z-index: 10;
  /* bottom padding clears the last card's translateY peek overflow
     (--peek, set inline from the slide count) plus a clear gap before
     the footer. */
  padding: 6rem 1.5rem calc(9.6rem + var(--peek, 0px));
  font-family: 'Kanit', sans-serif;
  /* IMPORTANT: must stay overflow:visible so sticky cards can pin */
}
@media (min-width: 640px) { .jack-projects { border-radius:0; margin-top:4rem;   padding:7.2rem 2.4rem calc(9.6rem + var(--peek, 0px));    } }
@media (min-width: 768px) { .jack-projects { border-radius:0; margin-top:5rem; padding:9.6rem 3rem calc(12rem + var(--peek, 0px));  } }

/* ── Heading ──────────────────────────────────────────────── */
.jack-proj-h2 {
  font-family: 'Kanit', sans-serif;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: -0.03em;
  line-height: 1;
  text-align: center;
  font-size: clamp(3rem, 12vw, 160px);
  margin: 0 0 4rem;
}

/* ── Card: direct siblings sharing one sticky context so each new
   card pins on top of the previous (pile-up effect). top, z-index
   and background are set inline per block (so any number of blocks
   works automatically). ──────────────────────────────────────── */
/* Sticky wrapper — IDENTICAL for every card: same `top` AND same
   height (no padding-top). Because the sticky boxes are identical,
   all cards un-stick at the exact same scroll point, so the whole
   stack scrolls away together once stacked (uniform animation). */
.jack-card {
  position: sticky;
  top: 6rem;
  margin-bottom: 1.3vh;          /* MOBILE gap between cards (−70% from 4.2vh) */
}
@media (min-width: 640px) { .jack-card { top:7rem; } }
@media (min-width: 768px) { .jack-card { top:8rem; margin-bottom: 10vh; } } /* DESKTOP: clear gap between cards before the next overlaps */

/* Visible card surface. The staggered peek is created here with
   transform: translateY(index × 28px) — a purely VISUAL shift that
   does NOT change the wrapper's sticky box, so release stays uniform.
   (JS adds a scale on top, preserving this translate.) */
.jack-card-inner {
  border-radius: 32px;
  border: 1px solid rgba(215,226,234,0.14);
  background: #111111;
  padding: 1.25rem;
  transform-origin: center top;
  transform: translateY(calc(var(--i, 0) * 28px));
  will-change: transform;
}
@media (min-width: 640px) { .jack-card-inner { border-radius:40px; padding:1.5rem; } }
@media (min-width: 768px) { .jack-card-inner { border-radius:50px; padding:2rem;   } }

/* ── Card header ──────────────────────────────────────────── */
.jack-card-top {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.25rem;
  flex-wrap: wrap;
}
.jack-card-num {
  color: #D7E2EA;
  font-family: 'Kanit', sans-serif;
  font-weight: 900;
  font-size: clamp(3rem, 10vw, 140px);
  line-height: 1;
  flex-shrink: 0;
}
.jack-card-meta { display:flex; flex-direction:column; gap:0.2rem; flex:1; }
.jack-card-name {
  color: #D7E2EA;
  font-size: clamp(1rem, 2.2vw, 2rem);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.02em;
}

/* ── CTA button ───────────────────────────────────────────── */
.jack-live-btn {
  display:inline-flex; align-items:center; gap:0.7rem;
  padding:1rem 3rem;
  background:linear-gradient(135deg,#000 0%,#1e1e1e 35%,#5a5a5a 65%,#c8c8c8 100%);
  box-shadow:0 4px 16px rgba(255,255,255,0.12),inset 2px 2px 8px rgba(255,255,255,0.08);
  outline:2px solid rgba(255,255,255,0.7); outline-offset:-3px;
  border-radius:9999px; border:none; color:#fff;
  font-family:'Kanit',sans-serif; font-weight:600;
  text-transform:uppercase; letter-spacing:0.14em;
  font-size:clamp(0.9rem,1.6vw,1.25rem);
  text-decoration:none; cursor:pointer; overflow:hidden;
  position:relative; white-space:nowrap; margin-left:auto;
  animation:jack-float 3s ease-in-out 1s infinite;
}
@media (min-width: 640px) { .jack-live-btn { padding:1.1rem 3.5rem; } }
@media (min-width: 768px) { .jack-live-btn { padding:1.25rem 4rem;  } }
.jack-live-btn:hover { animation-play-state:paused; opacity:0.9; transform:translateY(-3px) scale(1.03); }
.jack-live-btn::before {
  content:''; position:absolute; top:0; left:-75%; width:50%; height:100%;
  background:linear-gradient(105deg,transparent 20%,rgba(255,255,255,0.22) 50%,transparent 80%);
  transform:skewX(-15deg);
}
.jack-live-btn:hover::before { left:130%; transition:left 0.55s ease; }
@keyframes jack-float {
  0%,100% { transform:translateY(0);    box-shadow:0 4px 20px rgba(255,255,255,0.12),inset 2px 2px 8px rgba(255,255,255,0.08); }
  50%     { transform:translateY(-6px); box-shadow:0 12px 36px rgba(255,255,255,0.22),inset 2px 2px 8px rgba(255,255,255,0.12); }
}

/* ── Image grid ───────────────────────────────────────────────
   Image blocks use EXPLICIT fixed heights (not aspect-ratio), so every
   card is guaranteed the exact same total height regardless of whether
   an image has loaded. Identical card heights => all cards un-stick at
   the same scroll point => the whole stack scrolls away together.
   Images fill their fixed block via object-fit:cover (block size never
   depends on the image). A dark bg keeps un-loaded blocks from looking
   empty / collapsing.                                                  */
/* Left-image heights live in CSS vars so the right image can reference
   them and stay matched automatically at every breakpoint. */
.jack-card-imgs {
  display:flex; gap:0.75rem; align-items:stretch;
  --img-top: clamp(120px,14vw,200px);
  --img-bot: clamp(150px,17vw,240px);
  --img-gap: 0.75rem;
}
.jack-card-col1 { display:flex; flex-direction:column; gap:var(--img-gap); width:40%; flex-shrink:0; }
.jack-card-col2 { flex:1; display:flex; }

/* Media tile: wraps each image so it can double as a product link
   WITHOUT changing the fixed-height layout (the tile carries the fixed
   height, the image just fills it). Heights are set via explicit slot
   classes so the tiles can be <a> or <div> and still line up. */
.jack-media {
  display:block; width:100%; overflow:hidden; border-radius:24px;
  background:#0c0c0c; position:relative; text-decoration:none;
}
.jack-media img {
  width:100%; height:100%; object-fit:cover; display:block;
  transition: transform 0.6s cubic-bezier(0.25,0.46,0.45,0.94),
              opacity 0.35s ease;
}
a.jack-media:hover img { transform: scale(1.05); }   /* subtle zoom on product tiles */
/* Crossfade while the 10s rotation swaps in the next product */
.jack-media.is-swapping img { opacity: 0; }
@media (prefers-reduced-motion: reduce) {
  .jack-media img { transition: none; }
}
@media (min-width:640px){ .jack-media { border-radius:32px; } }
@media (min-width:768px){ .jack-media { border-radius:40px; } }

.jack-card-col1 .jack-media--top { height: var(--img-top); }   /* top — fixed */
.jack-card-col1 .jack-media--bot { height: var(--img-bot); }   /* bottom — fixed */
/* Right tile = exact sum of the two left tiles + the gap between them,
   so it lines up with the left column at top and bottom. */
.jack-card-col2 .jack-media--right {
  width:100%;
  height: calc(var(--img-top) + var(--img-bot) + var(--img-gap));
  min-height: 0;
}

/* DESKTOP: enlarge both left images by 50% (right image auto-matches
   because it's computed from the same vars). */
@media (min-width: 768px) {
  .jack-card-imgs {
    --img-top: clamp(180px,21vw,300px);
    --img-bot: clamp(225px,25.5vw,360px);
  }
}
</style>

{%- liquid
  assign d_bg = '#111111,#141414,#171717,#1a1a1a,#1d1d1d,#202020' | split: ','
  comment
    Total downward peek of the last card = (slides - 1) × 28px.
    The section's bottom padding adds this so the last card never
    overlaps the footer.
  endcomment
  assign peek_total = section.blocks.size | minus: 1 | times: 28
-%}

<section class="jack-projects" id="jack-projects" style="--peek:{{ peek_total }}px;">

  <h2 class="jack-proj-h2 jack-grad jfi jfi-dn" data-jfi-delay="0">
    {{ section.settings.heading | default: 'Best Solutions' }}
  </h2>

  {%- for block in section.blocks -%}
    {%- liquid
      assign i  = forloop.index0
      assign mi = i | modulo: 6

      assign num = forloop.index | prepend: '0' | slice: -2, 2

      assign bg = d_bg[mi] | default: '#202020'

      comment
        Only products with a hero image can fill a tile. The first 3 are
        rendered server-side (so the card is correct without JS); the script
        at the bottom re-rolls them at random on load and every 10s.
      endcomment
      assign pool = block.settings.collection.products | where: 'featured_image'
      assign pool_size = pool.size
    -%}
    <div class="jack-card"
         style="--i:{{ i }}; z-index:{{ forloop.index }};"
         {{ block.shopify_attributes }}>
      <div class="jack-card-inner" style="background:{{ bg }};">
        <div class="jack-card-top">
          <span class="jack-card-num">{{ num }}</span>
          <div class="jack-card-meta">
            <span class="jack-card-name">{{ block.settings.heading }}</span>
          </div>
          <a href="{{ block.settings.button_link | default: '/collections/all' }}" class="jack-live-btn">
            {{ block.settings.button_label | default: 'Explore Now' }} &#8594;
          </a>
        </div>
        <div class="jack-card-imgs">
          <div class="jack-card-col1">
            {%- render 'jack-project-tile', pool: pool, pool_size: pool_size, slot: 0, extra_class: 'jack-media--top' -%}
            {%- render 'jack-project-tile', pool: pool, pool_size: pool_size, slot: 1, extra_class: 'jack-media--bot' -%}
          </div>
          <div class="jack-card-col2">
            {%- render 'jack-project-tile', pool: pool, pool_size: pool_size, slot: 2, extra_class: 'jack-media--right' -%}
          </div>
        </div>

        {%- comment -%}
          Every product in the collection, for the rotation script. Rendered as
          JSON rather than markup so swapping costs nothing but an image load.
        {%- endcomment -%}
        <script type="application/json" class="jack-card-data">
          [
            {%- for p in pool -%}
              {"u":{{ p.url | json }},"t":{{ p.title | json }},"s":{{ p.featured_image | image_url: width: 1280 | json }}}{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        </script>
      </div>
    </div>
  {%- endfor -%}

</section>

<script>
/* Product rotation — each card shows 3 random products from its collection
   and re-rolls them every 10s. Products are drawn from a shuffled queue, so
   the whole collection cycles through before any product repeats. */
(function () {
  var SWAP_MS  = 10000;
  var FADE_MS  = 350;   /* keep in sync with the .is-swapping transition */

  Array.prototype.forEach.call(
    document.querySelectorAll('.jack-projects .jack-card-inner'),
    function (card) {
      var dataEl = card.querySelector('.jack-card-data');
      var slots  = Array.prototype.slice.call(card.querySelectorAll('.jack-media'));
      if (!dataEl || !slots.length) return;

      var items;
      try { items = JSON.parse(dataEl.textContent); } catch (e) { return; }
      if (!items || !items.length) return;

      var queue = [];

      function refill() {
        var pool = items.slice();
        for (var i = pool.length - 1; i > 0; i--) {   /* Fisher-Yates */
          var j = Math.floor(Math.random() * (i + 1));
          var tmp = pool[i]; pool[i] = pool[j]; pool[j] = tmp;
        }
        queue = queue.concat(pool);
      }

      /* Next n products, never repeating within one trio unless the
         collection genuinely has fewer than n products. */
      function take(n) {
        var out = [], guard = 0;
        while (out.length < n && guard++ < 100) {
          if (!queue.length) refill();
          var next = queue.shift();
          if (items.length >= n && out.indexOf(next) !== -1) { queue.push(next); continue; }
          out.push(next);
        }
        return out;
      }

      function apply(slot, item) {
        var img = slot.querySelector('img');
        if (!img) return;
        img.src = item.s;
        img.alt = item.t;
        if (slot.tagName === 'A') {
          slot.setAttribute('href', item.u);
          slot.setAttribute('aria-label', item.t);
        }
      }

      function paint(picks, animate) {
        slots.forEach(function (slot, i) {
          var item = picks[i];
          if (!item) return;
          if (!animate) { apply(slot, item); return; }
          /* Preload first so the tile never flashes empty mid-fade. */
          var pre = new Image();
          pre.onload = pre.onerror = function () {
            slot.classList.add('is-swapping');
            setTimeout(function () {
              apply(slot, item);
              slot.classList.remove('is-swapping');
            }, FADE_MS);
          };
          pre.src = item.s;
        });
      }

      paint(take(slots.length), false);   /* randomise on load */

      if (items.length > 1) {
        setInterval(function () {
          if (document.hidden) return;    /* don't burn through the queue in a background tab */
          paint(take(slots.length), true);
        }, SWAP_MS);
      }
    }
  );
})();
</script>

<script>
(function () {
  var wraps  = Array.prototype.slice.call(
    document.querySelectorAll('.jack-projects .jack-card')
  );
  if (!wraps.length) return;
  var inners = wraps.map(function (w) { return w.querySelector('.jack-card-inner'); });
  var TOTAL  = wraps.length;

  var PEEK = 28; /* px each card is shifted down — keep in sync with CSS */

  function update() {
    wraps.forEach(function (wrap, i) {
      var inner = inners[i];
      if (!inner) return;
      var ty   = 'translateY(' + (i * PEEK) + 'px)';
      var next = wraps[i + 1];
      if (!next) { inner.style.transform = ty + ' scale(1)'; return; }

      var thisTop = wrap.getBoundingClientRect().top;
      var nextTop = next.getBoundingClientRect().top;
      var gap     = nextTop - thisTop;

      var span     = window.innerHeight * 0.85;
      var progress = Math.max(0, Math.min(1, 1 - gap / span));

      var targetScale = 1 - (TOTAL - 1 - i) * 0.04;
      var scale       = 1 - (1 - targetScale) * progress;

      inner.style.transform = ty + ' scale(' + scale + ')';
    });
  }

  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update, { passive: true });
  update();
})();
</script>

{% schema %}
{
  "name": "Best Solutions",
  "tag": "div",
  "class": "jack-projects-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Best Solutions"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "text",         "id": "heading",      "label": "Title",            "default": "Smart Home" },
        { "type": "collection",   "id": "collection",   "label": "Product collection", "info": "Shows 3 products picked at random from this collection, re-rolling every 10 seconds. Each tile links to its product page." },
        { "type": "text",         "id": "button_label", "label": "Button label",     "default": "Explore Now" },
        { "type": "url",          "id": "button_link",  "label": "Button link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Best Solutions",
      "blocks": [
        { "type": "slide", "settings": { "heading": "Smart Home" } },
        { "type": "slide", "settings": { "heading": "Health & Wellness" } },
        { "type": "slide", "settings": { "heading": "Beauty & Self-Care" } },
        { "type": "slide", "settings": { "heading": "Pet Essentials" } },
        { "type": "slide", "settings": { "heading": "Baby & Parenting" } },
        { "type": "slide", "settings": { "heading": "Work & Productivity" } }
      ]
    }
  ]
}
{% endschema %}
