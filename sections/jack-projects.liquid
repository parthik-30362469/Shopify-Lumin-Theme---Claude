<script>
(function () {
  var stage   = document.getElementById('jack-cards-stage');
  if (!stage) return;
  var cards   = Array.from(stage.querySelectorAll('.jack-card'));
  var N       = cards.length;
  if (!N) return;

  /* How far from viewport top the cards rest when "stuck" (≈ header height) */
  var STUCK_TOP_REM = 5.5;
  var SCALE_COVERED = 0.93; /* scale of a card that has been stacked over */

  function remToPx(r) {
    return r * parseFloat(getComputedStyle(document.documentElement).fontSize);
  }

  function setup() {
    /* Give the stage enough height so each card has a full viewport of
       scroll runway before the next one slides in.
       Total = N * vh + last-card height                               */
    var vh      = window.innerHeight;
    var cardH   = cards[0].offsetHeight;
    stage.style.height = (N * vh + cardH) + 'px';
    update();
  }

  function update() {
    var vh       = window.innerHeight;
    var stuckPx  = remToPx(STUCK_TOP_REM);
    var stageTop = stage.getBoundingClientRect().top; /* stage top rel. to viewport */

    /* scrolledIntoStage: how many px the user has scrolled past the stage top */
    var scrolled = -stageTop; /* positive once stage starts scrolling up */

    cards.forEach(function (card, i) {
      card.style.zIndex = i + 1; /* higher index = on top */

      /* Each card's scroll window: card i activates after i * vh of scrolling */
      var activateAt = i * vh;          /* px scrolled when card starts rising */
      var arrivedAt  = activateAt + vh; /* px scrolled when card is fully stuck */

      var raw = (scrolled - activateAt) / vh; /* 0 = start rising, 1 = fully stuck */
      var t   = Math.max(0, Math.min(1, raw));

      /* translateY: start at vh (off-screen below), end at stuckPx (stuck) */
      var startY = vh;
      var endY   = Math.max(0, stuckPx - stageTop - (i === 0 ? 0 : 0));
      /* endY is relative to the stage top, which moves as we scroll.
         We want the card to stay at stuckPx from viewport top.
         Card is absolute inside stage, so card's top = stuckPx - stageTop */
      endY = stuckPx - stageTop;

      if (raw < 0) {
        /* Not yet on screen */
        card.style.transform = 'translateY(' + vh + 'px) scale(1)';
      } else if (raw < 1) {
        /* Sliding in with smooth easing */
        var eased = 1 - Math.pow(1 - t, 3); /* ease-out cubic */
        var y     = startY + (endY - startY) * eased;
        card.style.transform = 'translateY(' + y + 'px) scale(1)';
      } else {
        /* Fully stuck — keep pinned at correct viewport position */
        /* endY recalculated live so it tracks as page scrolls */
        var pinnedY = stuckPx - stageTop;
        card.style.transform = 'translateY(' + pinnedY + 'px) scale(1)';
      }

      /* Scale down this card once the next one has arrived on top of it */
      if (i < N - 1) {
        var nextRaw    = (scrolled - (i + 1) * vh) / vh;
        var nextCover  = Math.max(0, Math.min(1, nextRaw));
        var scale      = 1 - (1 - SCALE_COVERED) * nextCover;
        var currentY   = parseFloat(card.style.transform.match(/translateY\(([^)]+)\)/)[1]);
        card.style.transform = 'translateY(' + currentY + 'px) scale(' + scale + ')';
      }
    });
  }

  /* Initialise after images have loaded so card height is accurate */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup);
  } else {
    setup();
  }
  window.addEventListener('load',   setup); /* re-run once images load */
  window.addEventListener('resize', setup, { passive: true });
  window.addEventListener('scroll', update, { passive: true });
})();
</script>

