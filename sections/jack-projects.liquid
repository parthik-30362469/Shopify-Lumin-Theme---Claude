{%- comment -%} Jack — Projects: scroll-driven sticky stacking cards {%- endcomment -%}

<style>
/* ── Section ──────────────────────────────────────────────── */
.jack-projects {
  background: #0C0C0C;
  border-radius: 40px 40px 0 0;
  margin-top: -2.5rem;
  position: relative;
  z-index: 10;
  padding: 5rem 1.25rem 0;
  font-family: 'Kanit', sans-serif;
}
@media (min-width: 640px) { .jack-projects { border-radius:50px 50px 0 0; margin-top:-3rem;   padding:6rem 2rem 0;   } }
@media (min-width: 768px) { .jack-projects { border-radius:60px 60px 0 0; margin-top:-3.5rem; padding:8rem 2.5rem 0;} }

/* ── Heading ──────────────────────────────────────────────── */
.jack-proj-h2 {
  font-family: 'Kanit', sans-serif;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: -0.03em;
  line-height: 1;
  text-align: center;
  font-size: clamp(3rem, 12vw, 160px);
  margin: 0 0 4rem;
}

/* ── Scroll slot ──────────────────────────────────────────────
   Each slot is 100 vh tall — this gives the scroll distance
   for the NEXT card to travel from the bottom of the viewport
   all the way up to the sticky position, creating the
   "slide over and stack" effect.
   The last slot uses auto height so the section ends cleanly.
────────────────────────────────────────────────────────────── */
.jack-proj-slot {
  height: 100vh;
  position: relative;
}
.jack-proj-slot:last-child {
  height: auto;
  padding-bottom: 10rem;
}

/* ── Card — ALL share the same top so they stack at the
   exact same screen position. z-index increases per card
   so later cards paint on top of earlier ones.
──────────────────────────────────────────────────────────── */
.jack-card {
  position: sticky;
  top: 5rem;                  /* same for every card */
  border-radius: 32px;
  border: 1px solid rgba(215,226,234,0.12);
  background: #111111;        /* solid — covers card below */
  padding: 1.25rem;
  will-change: transform;
  transform-origin: top center;
  transition: transform 0.05s linear;
}
@media (min-width: 640px) { .jack-card { border-radius:40px; padding:1.5rem; top:5.5rem; } }
@media (min-width: 768px) { .jack-card { border-radius:50px; padding:2rem;   top:6rem;   } }

/* Subtle tonal shift so stacked depth is visible */
.jack-proj-slot:nth-child(2) .jack-card { background: #141414; }
.jack-proj-slot:nth-child(3) .jack-card { background: #181818; }
.jack-proj-slot:nth-child(4) .jack-card { background: #1c1c1c; }

/* ── Card header row ──────────────────────────────────────── */
.jack-card-top {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.25rem;
  flex-wrap: wrap;
}
.jack-card-num {
  color: #D7E2EA;
  font-family: 'Kanit', sans-serif;
  font-weight: 900;
  font-size: clamp(3rem, 10vw, 140px);
  line-height: 1;
  flex-shrink: 0;
}
.jack-card-meta {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  flex: 1;
}
.jack-card-category {
  color: rgba(215,226,234,0.55);
  font-size: clamp(0.7rem, 1.2vw, 0.95rem);
  font-weight: 300;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}
.jack-card-name {
  color: #D7E2EA;
  font-size: clamp(1rem, 2.2vw, 2rem);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.02em;
}

/* ── CTA button ───────────────────────────────────────────── */
.jack-live-btn {
  display:         inline-flex;
  align-items:     center;
  gap:             0.7rem;
  padding:         1rem 3rem;
  background:      linear-gradient(135deg, #000000 0%, #1e1e1e 35%, #5a5a5a 65%, #c8c8c8 100%);
  box-shadow:      0 4px 16px rgba(255,255,255,0.12), inset 2px 2px 8px rgba(255,255,255,0.08);
  outline:         2px solid rgba(255,255,255,0.7);
  outline-offset:  -3px;
  border-radius:   9999px;
  border:          none;
  color:           #ffffff;
  font-family:     'Kanit', sans-serif;
  font-weight:     600;
  text-transform:  uppercase;
  letter-spacing:  0.14em;
  font-size:       clamp(0.9rem, 1.6vw, 1.25rem);
  text-decoration: none;
  cursor:          pointer;
  overflow:        hidden;
  position:        relative;
  white-space:     nowrap;
  margin-left:     auto;
  animation:       jack-float 3s ease-in-out 1s infinite;
}
@media (min-width: 640px) { .jack-live-btn { padding: 1.1rem 3.5rem; } }
@media (min-width: 768px) { .jack-live-btn { padding: 1.25rem 4rem;  } }
.jack-live-btn:hover {
  animation-play-state: paused;
  opacity: 0.9;
  transform: translateY(-3px) scale(1.03);
}
.jack-live-btn::before {
  content:    '';
  position:   absolute;
  top:0; left:-75%; width:50%; height:100%;
  background: linear-gradient(105deg, transparent 20%, rgba(255,255,255,0.22) 50%, transparent 80%);
  transform:  skewX(-15deg);
}
.jack-live-btn:hover::before {
  left:       130%;
  transition: left 0.55s ease;
}
@keyframes jack-float {
  0%,100% { transform:translateY(0);    box-shadow:0 4px 20px rgba(255,255,255,0.12),inset 2px 2px 8px rgba(255,255,255,0.08); }
  50%     { transform:translateY(-6px); box-shadow:0 12px 36px rgba(255,255,255,0.22),inset 2px 2px 8px rgba(255,255,255,0.12); }
}

/* ── Image grid ───────────────────────────────────────────── */
.jack-card-imgs { display: flex; gap: 0.75rem; }
.jack-card-col1 { display:flex; flex-direction:column; gap:0.75rem; width:40%; flex-shrink:0; }
.jack-card-col2 { flex: 1; }
.jack-card-col1 img,
.jack-card-col2 img {
  width: 100%;
  object-fit: cover;
  display: block;
  border-radius: 24px;
}
@media (min-width: 640px) { .jack-card-col1 img,.jack-card-col2 img { border-radius:32px; } }
@media (min-width: 768px) { .jack-card-col1 img,.jack-card-col2 img { border-radius:40px; } }
.jack-card-col1 img:first-child { height: clamp(120px,15vw,210px); }
.jack-card-col1 img:last-child  { height: clamp(150px,21vw,320px); }
.jack-card-col2 img             { height: 100%; min-height: clamp(270px,36vw,530px); }
</style>

