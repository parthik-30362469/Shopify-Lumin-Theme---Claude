<script>
/*
 * Scroll-driven sticky stacking cards
 *
 * As card N+1 slides up from below and approaches card N's sticky
 * position, card N scales down slightly (1 → 0.94) giving a depth
 * "push back" feel. This is the only JS needed — the actual stacking
 * is handled entirely by CSS position:sticky + z-index.
 *
 * Unwrapping (scroll up) reverses automatically because sticky CSS
 * restores each card to its natural document position.
 */
(function () {
  var cards = Array.from(document.querySelectorAll('.jack-projects .jack-card'));
  if (!cards.length) return;

  var SCALE_MIN   = 0.94;   /* how small a covered card gets */
  var STICKY_TOP  = 0;      /* recalculated on first run */

  function getStickyTop() {
    /* Read the actual computed top from the first card */
    return parseFloat(getComputedStyle(cards[0]).top) || 80;
  }

  function update() {
    if (!STICKY_TOP) STICKY_TOP = getStickyTop();
    var vh = window.innerHeight;

    cards.forEach(function (card, i) {
      var nextCard = cards[i + 1];

      if (!nextCard) {
        /* Last card: always full size */
        card.style.transform = 'scale(1)';
        return;
      }

      /* How far has the next card travelled toward this card's sticky pos?
         nextRect.top == vh      → next card just reached bottom of screen (progress 0)
         nextRect.top == STICKY_TOP → next card fully covering this one  (progress 1) */
      var nextTop      = nextCard.getBoundingClientRect().top;
      var travelTotal  = vh - STICKY_TOP;
      var progress     = Math.max(0, Math.min(1, (vh - nextTop) / travelTotal));

      /* Scale this card down as the next one approaches */
      var scale = 1 - (1 - SCALE_MIN) * progress;
      card.style.transform = 'scale(' + scale + ')';
    });
  }

  /* Recalculate sticky top on resize (breakpoint changes top value) */
  window.addEventListener('resize', function () { STICKY_TOP = 0; }, { passive: true });
  window.addEventListener('scroll', update, { passive: true });
  update();
})();
</script>

