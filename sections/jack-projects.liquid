{%- comment -%} Jack 3D Creator — Projects Section with sticky stacking cards {%- endcomment -%}

<style>
.jack-projects {
  background: #0C0C0C;
  border-radius: 40px 40px 0 0;
  margin-top: -2.5rem;
  position: relative;
  z-index: 10;
  padding: 5rem 1.25rem 8rem;
  font-family: 'Kanit', sans-serif;
}
@media (min-width: 640px) { .jack-projects { border-radius:50px 50px 0 0; margin-top:-3rem;   padding:6rem 2rem 10rem;    } }
@media (min-width: 768px) { .jack-projects { border-radius:60px 60px 0 0; margin-top:-3.5rem; padding:8rem 2.5rem 12rem;  } }

.jack-proj-h2 {
  font-family: 'Kanit', sans-serif;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: -0.03em;
  line-height: 1;
  text-align: center;
  font-size: clamp(3rem, 12vw, 160px);
  margin: 0 0 5rem;
}

/* Each project occupies 85vh so sticky effect has room */
.jack-proj-slot {
  height: 85vh;
  position: relative;
}

.jack-card {
  position: sticky;
  top: 6rem;
  border-radius: 40px;
  border: 2px solid #D7E2EA;
  background: #0C0C0C;
  padding: 1rem;
  will-change: transform;
  transform-origin: center top;
}
@media (min-width: 640px) { .jack-card { border-radius:50px; padding:1.5rem; top:7rem; } }
@media (min-width: 768px) { .jack-card { border-radius:60px; padding:2rem;   top:8rem; } }

/* Card top row */
.jack-card-top {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.5rem;
  flex-wrap: wrap;
}
.jack-card-num {
  color: #D7E2EA;
  font-family: 'Kanit', sans-serif;
  font-weight: 900;
  font-size: clamp(3rem, 10vw, 140px);
  line-height: 1;
  flex-shrink: 0;
}
.jack-card-meta {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  flex: 1;
}
.jack-card-category {
  color: rgba(215,226,234,0.6);
  font-size: clamp(0.75rem, 1.2vw, 1rem);
  font-weight: 300;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}
.jack-card-name {
  color: #D7E2EA;
  font-size: clamp(1rem, 2.2vw, 2rem);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.02em;
}
.jack-live-btn {
  display: inline-flex;
  align-items: center;
  border-radius: 9999px;
  border: 2px solid #D7E2EA;
  color: #D7E2EA;
  font-family: 'Kanit', sans-serif;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-size: 0.875rem;
  padding: 0.75rem 2rem;
  text-decoration: none;
  transition: background 0.2s;
  white-space: nowrap;
  margin-left: auto;
}
@media (min-width: 640px) { .jack-live-btn { padding:0.875rem 2.5rem; font-size:1rem; } }
.jack-live-btn:hover { background: rgba(215,226,234,0.1); }

/* Card image grid */
.jack-card-imgs {
  display: flex;
  gap: 0.75rem;
}
.jack-card-col1 {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  width: 40%;
  flex-shrink: 0;
}
.jack-card-col2 {
  flex: 1;
}
.jack-card-col1 img,
.jack-card-col2 img {
  width: 100%;
  object-fit: cover;
  display: block;
  border-radius: 40px;
}
@media (min-width: 640px) { .jack-card-col1 img, .jack-card-col2 img { border-radius:50px; } }
@media (min-width: 768px) { .jack-card-col1 img, .jack-card-col2 img { border-radius:60px; } }

.jack-card-col1 img:first-child { height: clamp(130px, 16vw, 230px); }
.jack-card-col1 img:last-child  { height: clamp(160px, 22vw, 340px); }
.jack-card-col2 img             { height: 100%; min-height: clamp(290px, 38vw, 570px); }
</style>

