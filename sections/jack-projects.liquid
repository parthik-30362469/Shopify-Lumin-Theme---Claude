<script>
(function(){
  /* ── Sticky card scale effect ── */
  var slots = document.querySelectorAll('.jack-proj-slot');
  var cards = document.querySelectorAll('.jack-proj-slot .jack-card');
  var TOTAL = cards.length;

  function updateCards(){
    cards.forEach(function(card, i){
      var slot = card.parentElement;
      var rect = slot.getBoundingClientRect();
      var progress = 1 - (rect.bottom / window.innerHeight);
      var clamped = Math.max(0, Math.min(1, progress));
      var targetScale = 1 - (TOTAL - 1 - i) * 0.03;
      var scale = 1 - (1 - targetScale) * clamped;
      var offsetY = i * 28;
      card.style.transform = 'translateY(' + offsetY + 'px) scale(' + scale + ')';
    });
  }

  window.addEventListener('scroll', updateCards, { passive:true });
  updateCards();
})();
</script>

