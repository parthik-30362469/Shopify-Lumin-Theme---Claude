{%- comment -%} Jack 3D Creator — Hero Section {%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
/* ── Global portfolio reset ───────────────────────────────── */
html, body.template-index, body.template-index #root {
  background: #0C0C0C !important;
  font-family: 'Kanit', sans-serif !important;
  overflow-x: clip !important;
}
/* header-wrapper visible — using original theme header */
body.template-index .shopify-section {
  background: transparent !important;
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
  box-shadow: none !important;
}
.shopify-section:has(.jack-hero) { background: #0C0C0C !important; }

/* ── Gradient text utility ─────────────────────────────────── */
.jack-grad {
  background: linear-gradient(180deg, #646973 0%, #BBCCD7 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ── Hero wrapper ──────────────────────────────────────────── */
.jack-hero {
  height: 100vh;
  min-height: 600px;
  display: flex;
  flex-direction: column;
  overflow-x: clip;
  position: relative;
  z-index: 0;
  background: #0C0C0C;
  font-family: 'Kanit', sans-serif;
  padding-top: 2.5rem;
}

/* Ensure header group (nav + menu drawer) always sits above the hero */
body.template-index .shopify-section-group-header-group {
  z-index: 200 !important;
}
@media (min-width: 640px)  { .jack-hero { padding-top: 3rem;   } }
@media (min-width: 768px)  { .jack-hero { padding-top: 3.5rem; } }
@media (min-width: 1024px) { .jack-hero { padding-top: 4rem;   } }

/* ── Navbar ────────────────────────────────────────────────── */
.jack-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem 1.5rem 0;
  position: relative;
  z-index: 30;
}
@media (min-width: 768px) { .jack-nav { padding: 2rem 2.5rem 0; } }

.jack-nav a {
  color: #D7E2EA;
  font-family: 'Kanit', sans-serif;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-size: clamp(0.75rem, 1.4vw, 1.4rem);
  text-decoration: none;
  transition: opacity 200ms;
}
.jack-nav a:hover { opacity: 0.7; }

/* ── Hero heading ──────────────────────────────────────────── */
.jack-h1-outer {
  overflow: hidden;
  padding: 0 0.2rem;
  position: relative;
  z-index: 20;
  flex-shrink: 0;
}
.jack-h1 {
  font-family:    'Kanit', sans-serif;
  font-weight:    900;
  text-transform: uppercase;
  letter-spacing: -0.03em;
  line-height:    0.93;
  text-align:     center;
  width:          100%;
  font-size:      5.5vw;
  margin-top:     1.5rem;
}
@media (min-width: 640px)  { .jack-h1 { font-size: 6vw;   margin-top: 0; } }
@media (min-width: 768px)  { .jack-h1 { font-size: 6.5vw; margin-top: 0; } }
@media (min-width: 1024px) { .jack-h1 { font-size: 7vw;   margin-top: 0; } }

/* ── Hero CTA block ────────────────────────────────────────── */
.jack-hero-cta-wrap {
  display:         flex;
  justify-content: center;
  position:        relative;
  z-index:         30;
  margin-top:      2rem;
  flex-shrink:     0;
}

.jack-explore-btn {
  display:         inline-flex;
  align-items:     center;
  gap:             0.7rem;
  padding:         1rem 3rem;
  background:      linear-gradient(135deg, #000000 0%, #1e1e1e 35%, #5a5a5a 65%, #c8c8c8 100%);
  box-shadow:      0 4px 16px rgba(255,255,255,0.12), inset 2px 2px 8px rgba(255,255,255,0.08);
  outline:         2px solid rgba(255,255,255,0.7);
  outline-offset:  -3px;
  border-radius:   9999px;
  border:          none;
  color:           white;
  font-family:     'Kanit', sans-serif;
  font-weight:     600;
  text-transform:  uppercase;
  letter-spacing:  0.14em;
  font-size:       clamp(0.9rem, 1.6vw, 1.25rem);
  text-decoration: none;
  cursor:          pointer;
  overflow:        hidden;
  position:        relative;
  /* entrance then float */
  animation:       jfi-btn-in  0.7s cubic-bezier(.22,1,.36,1) 0.5s both,
                   jack-float  3s  ease-in-out               1.2s infinite;
}
@media (min-width: 640px) { .jack-explore-btn { padding: 1.1rem 3.5rem; } }
@media (min-width: 768px) { .jack-explore-btn { padding: 1.25rem 4rem;  } }

@keyframes jfi-btn-in {
  from { opacity:0; transform:translateY(14px); }
  to   { opacity:1; transform:translateY(0);    }
}
@keyframes jack-float {
  0%,100% { transform:translateY(0);    box-shadow:0 4px 20px rgba(255,255,255,0.12), inset 2px 2px 8px rgba(255,255,255,0.08); }
  50%     { transform:translateY(-6px); box-shadow:0 12px 36px rgba(255,255,255,0.22), inset 2px 2px 8px rgba(255,255,255,0.12); }
}

.jack-explore-btn:hover {
  animation-play-state: paused;
  opacity: 0.9;
  transform: translateY(-3px) scale(1.03);
}

/* Shimmer sweep */
.jack-explore-btn::before {
  content:    '';
  position:   absolute;
  top:0; left:-75%; width:50%; height:100%;
  background: linear-gradient(105deg, transparent 20%, rgba(255,255,255,0.22) 50%, transparent 80%);
  transform:  skewX(-15deg);
}
.jack-explore-btn:hover::before {
  left:       130%;
  transition: left 0.55s ease;
}

.jack-explore-arrow {
  display:    inline-block;
  transition: transform 0.22s ease;
}
.jack-explore-btn:hover .jack-explore-arrow { transform: translateX(4px); }

/* ── Portrait ──────────────────────────────────────────────── */
.jack-portrait {
  position: absolute;
  left: 50%;
  transform: translateX(-50%) translateY(-50%);
  top: 50%;
  z-index: 10;
}
@media (min-width: 640px) {
  .jack-portrait {
    top: auto;
    bottom: -2%;   /* slight bleed creates headline overlap */
    transform: translateX(-50%);
  }
}

/* ── Portrait image sizing ───────────────────────────────── */
.jack-portrait img {
  display: block;
  width: 280px;
  will-change: transform;
  pointer-events: none;
  user-select: none;
  -webkit-user-drag: none;
}
/* Desktop: height-based so image fills ~78% of viewport height,
   naturally overlapping the headline by ~10%                  */
@media (min-width: 640px)  { .jack-portrait img { width: auto; height: 68vh; max-width: 520px;  } }
@media (min-width: 768px)  { .jack-portrait img { height: 74vh; max-width: 640px; } }
@media (min-width: 1024px) { .jack-portrait img { height: 80vh; max-width: 780px; } }

/* ══════════════════════════════════════════════════════════
   ANIMATIONS — only transform + opacity ever change at runtime.
   Both properties stay on the GPU compositor thread → zero repaints
   → butter-smooth at 60/120 fps on both desktop and mobile.
   ══════════════════════════════════════════════════════════ */

/* Entrance: opacity + scale/translate only (no filter = no repaint) */
@keyframes jack-portrait-entrance {
  0%   { opacity: 0;   transform: scale(0.88) translate3d(0, 36px, 0); }
  55%  { opacity: 1;   transform: scale(1.04) translate3d(0, -6px, 0); }
  75%  {               transform: scale(0.99) translate3d(0,  2px, 0); }
  100% { opacity: 1;   transform: scale(1)    translate3d(0,  0,   0); }
}

/* Float: pure translate3d — GPU compositor only, zero paint cost.
   cubic-bezier(0.37,0,0.63,1) ≈ a sine wave → most natural rhythm */
@keyframes jack-portrait-float {
  0%, 100% { transform: translate3d(0,     0, 0); }
  50%       { transform: translate3d(0, -20px, 0); }
}

/* ── Orbital rings canvas ─────────────────────────────────── */
#jack-rings-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 8;          /* above background, below portrait (z-index:10) */
  pointer-events: none;
  will-change: transform; /* hoist to own compositor layer */
}

/* ── Portrait image ──────────────────────────────────────── */
.jack-portrait img {
  will-change: transform;          /* hoist to own GPU layer */
  backface-visibility: hidden;     /* prevent sub-pixel flicker */
  animation:
    jack-portrait-entrance  1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.2s  both,
    jack-portrait-float     5s   cubic-bezier(0.37, 0, 0.63, 1) 1.7s  infinite;
}

/* Pause float + orb on hover so magnet feels instant */
.jack-portrait:hover img     { animation-play-state: running, paused; }
.jack-portrait:hover::before { animation-play-state: paused; }

/* ── Bottom bar ────────────────────────────────────────────── */
.jack-hero-bot {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: auto;
  padding: 0 1.5rem 1.75rem;
  position: relative;
  z-index: 30;
}
@media (min-width: 640px) { .jack-hero-bot { padding: 0 2rem 2rem;    } }
@media (min-width: 768px) { .jack-hero-bot { padding: 0 2.5rem 2.5rem;} }

.jack-hero-desc {
  color: #D7E2EA;
  font-family: 'Kanit', sans-serif;
  font-weight: 300;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  line-height: 1.35;
  font-size: clamp(0.75rem, 1.4vw, 1.5rem);
  max-width: 160px;
}
@media (min-width: 640px) { .jack-hero-desc { max-width: 220px; } }
@media (min-width: 768px) { .jack-hero-desc { max-width: 260px; } }

/* ── ContactButton ─────────────────────────────────────────── */
.jack-contact-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(123deg, #18011F 7%, #B600A8 37%, #7621B0 72%, #BE4C00 100%);
  box-shadow: 0 4px 4px rgba(181,1,167,0.25), inset 4px 4px 12px #7721B1;
  outline: 2px solid white;
  outline-offset: -3px;
  border-radius: 9999px;
  border: none;
  color: white;
  font-family: 'Kanit', sans-serif;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  cursor: pointer;
  text-decoration: none;
  padding: 0.75rem 2rem;
  font-size: 0.75rem;
  white-space: nowrap;
  transition: opacity 0.2s;
}
@media (min-width: 640px) { .jack-contact-btn { padding: 0.875rem 2.5rem; font-size: 0.875rem; } }
@media (min-width: 768px) { .jack-contact-btn { padding: 1rem 3rem;       font-size: 1rem;     } }
.jack-contact-btn:hover { opacity: 0.88; }

/* ── FadeIn utility ────────────────────────────────────────── */
.jfi {
  opacity: 0;
  transition: opacity 0.7s cubic-bezier(.25,.1,.25,1),
              transform 0.7s cubic-bezier(.25,.1,.25,1);
}
.jfi.jfi-on { opacity: 1 !important; transform: none !important; }
.jfi-up { transform: translateY(-20px); }
.jfi-dn { transform: translateY(40px); }
.jfi-sm { transform: translateY(20px); }
.jfi-lg { transform: translateY(30px); }

/* ── Mobile-only overrides (max 639px) ─────────────────────── */
@media (max-width: 639px) {
  /* 1. Double heading size so it fills 2 bold lines */
  .jack-h1 {
    font-size:   11vw !important;
    margin-top:  0.75rem;
  }

  /* 2. Reduce top gap — pull portrait up toward the heading */
  .jack-portrait {
    top: 43% !important;
  }

  /* 3. Larger portrait fills more vertical space, shrinking both gaps */
  .jack-portrait img {
    width: 350px !important;
  }

  /* 4. Stack bottom bar vertically so tripled text has room */
  .jack-hero-bot {
    flex-direction: column;
    align-items:    flex-start;
    gap:            1.25rem;
    padding-bottom: 2rem;
  }

  /* 5. Triple the bottom-left label font size */
  .jack-hero-desc {
    font-size:   2.25rem !important;
    max-width:   100%;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.03em;
  }

  /* 6. Center the Explore Now button on mobile */
  .jack-explore-btn {
    align-self: center;
  }
}
</style>

<section class="jack-hero">

  <!-- 3D orbital text rings canvas -->
  <canvas id="jack-rings-canvas" aria-hidden="true"></canvas>

  <div class="jack-h1-outer">
    <h1 class="jack-h1 jfi jfi-dn" data-jfi-delay="0.15" style="-webkit-text-fill-color:#ffffff;color:#ffffff;">Innovations That Make Life Easier</h1>
  </div>


  <div class="jack-portrait" id="jack-magnet-wrap">
    <div id="jack-magnet-inner">
      <img
        src="https://cdn.shopify.com/s/files/1/0706/1343/4437/files/Picsart-BackgroundRemover.png?v=1779993149"
        alt="Jack portrait"
        loading="eager"
      >
    </div>
  </div>

  <div class="jack-hero-bot">
    <p class="jack-hero-desc jfi jfi-sm" data-jfi-delay="0.35">
      Striking and Unforgettable Innovations
    </p>
    <a href="/collections/all" class="jack-explore-btn jfi jfi-sm" data-jfi-delay="0.5">
      Explore Now
      <span class="jack-explore-arrow" aria-hidden="true">&#8594;</span>
    </a>
  </div>

</section>

<script>
(function(){
  /* ── FadeIn ── */
  function runFadeIns(){
    var els = document.querySelectorAll('.jfi');
    if(!('IntersectionObserver' in window)){
      els.forEach(function(e){ e.classList.add('jfi-on'); }); return;
    }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(!entry.isIntersecting) return;
        var el = entry.target;
        var d  = parseFloat(el.getAttribute('data-jfi-delay')||'0')*1000;
        setTimeout(function(){ el.classList.add('jfi-on'); }, d);
        io.unobserve(el);
      });
    },{ rootMargin:'50px', threshold:0 });
    els.forEach(function(e){ io.observe(e); });
  }

  /* ── Magnet ── */
  function runMagnet(){
    var wrap = document.getElementById('jack-magnet-wrap');
    var inner = document.getElementById('jack-magnet-inner');
    if(!wrap||!inner) return;
    var padding=150, strength=3;
    document.addEventListener('mousemove', function(e){
      var r=wrap.getBoundingClientRect();
      var cx=r.left+r.width/2, cy=r.top+r.height/2;
      var dx=e.clientX-cx, dy=e.clientY-cy;
      var dist=Math.sqrt(dx*dx+dy*dy);
      var zone=Math.max(r.width,r.height)/2+padding;
      if(dist<zone){
        inner.style.transform='translate3d('+(dx/strength)+'px,'+(dy/strength)+'px,0)';
        inner.style.transition='transform 0.3s ease-out';
      } else {
        inner.style.transform='translate3d(0,0,0)';
        inner.style.transition='transform 0.6s ease-in-out';
      }
    });
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded', function(){ runFadeIns(); runMagnet(); });
  } else { runFadeIns(); runMagnet(); }
})();
</script>

<script>
/* ── 3D Orbital Text Rings ─────────────────────────────────────────────
   Three rings of neon-orange glowing text orbit the hero image in 3D.
   Uses perspective projection: x3→x2 so rings look elliptical and
   characters scale + fade with depth (bright in front, dim behind).
   Only clearRect + fillText per frame — no layout, no repaint.
──────────────────────────────────────────────────────────────────────── */
(function () {
  var canvas = document.getElementById('jack-rings-canvas');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');

  /* Resize canvas to match its CSS size */
  function resize() {
    canvas.width  = canvas.offsetWidth  || window.innerWidth;
    canvas.height = canvas.offsetHeight || window.innerHeight;
  }
  resize();
  window.addEventListener('resize', resize);

  var isMobile = window.innerWidth < 640;

  /* ── Ring definitions ──────────────────────────────────────────────
     tiltDeg : how steeply the ring plane is tilted toward the viewer
     speed   : radians/sec (negative = reverse)
     rFactor : radius as fraction of Math.min(vw, vh)
     size    : base font size in px (scaled with depth)
     phase   : starting angle offset
  ─────────────────────────────────────────────────────────────────── */
  var RINGS = [
    {
      text    : 'INSTAZ CART  ✶  ',
      tiltDeg : 70,
      speed   : 0.50,
      rFactor : isMobile ? 0.38 : 0.30,
      size    : isMobile ? 11 : 14,
      phase   : 0
    },
    {
      text    : 'SMART SOLUTIONS  ✶  ',
      tiltDeg : 65,
      speed   : -0.32,
      rFactor : isMobile ? 0.52 : 0.42,
      size    : isMobile ? 10 : 12,
      phase   : Math.PI
    },
    {
      text    : 'INNOVATIONS  ✶  ',
      tiltDeg : 75,
      speed   : 0.22,
      rFactor : isMobile ? 0.66 : 0.54,
      size    : isMobile ? 9 : 11,
      phase   : Math.PI * 0.6
    }
  ];

  /* Neon orange palette */
  var COL_BRIGHT = 'rgb(255, 148, 48)';
  var COL_MID    = 'rgb(255, 110, 20)';

  function drawRing(ring, t) {
    var vMin   = Math.min(canvas.width, canvas.height);
    var radius = vMin * ring.rFactor;
    var cx     = canvas.width  * 0.5;
    var cy     = canvas.height * 0.50;
    var tilt   = ring.tiltDeg * Math.PI / 180;
    var fov    = Math.max(canvas.width, canvas.height) * 1.1;

    /* Build the text string to fill the ring circumference exactly */
    var circ      = 2 * Math.PI * radius;
    var approxCW  = ring.size * 0.58;
    var need      = Math.max(8, Math.ceil(circ / approxCW));
    var src       = ring.text;
    var full      = '';
    while (full.length < need) full += src;
    var chars = full.slice(0, need).split('');
    var step  = (2 * Math.PI) / chars.length;

    chars.forEach(function (ch, i) {
      var theta = ring.phase + i * step + t * ring.speed;

      /* 3D position on a tilted circle */
      var x3 =  radius * Math.cos(theta);
      var y3 =  radius * Math.sin(theta) * Math.sin(tilt);
      var z3 =  radius * Math.sin(theta) * Math.cos(tilt);

      /* Perspective divide */
      var p  = fov / (fov + z3);
      var x2 = cx + x3 * p;
      var y2 = cy + y3 * p;

      /* Depth-based alpha: near-invisible at back, full glow at front */
      var depth = (z3 + radius) / (2 * radius); /* 0 (back) → 1 (front) */
      var alpha = 0.04 + depth * 0.96;

      /* Font size shrinks with distance */
      var fs = Math.max(5, ring.size * p);

      /* Tangent direction so each char follows the ring curve */
      var tx    = -Math.sin(theta);
      var ty    =  Math.cos(theta) * Math.sin(tilt);
      var angle =  Math.atan2(ty, tx);

      ctx.save();
      ctx.translate(x2, y2);
      ctx.rotate(angle);
      ctx.globalAlpha = alpha;
      ctx.font = '600 ' + fs + 'px Kanit,sans-serif';
      ctx.textAlign    = 'center';
      ctx.textBaseline = 'middle';

      /* Glow halo — one pass with shadowBlur */
      ctx.shadowColor = 'rgba(255,100,10,' + (alpha * 0.9) + ')';
      ctx.shadowBlur  = isMobile ? 6 : Math.max(5, 14 * p);
      ctx.fillStyle   = depth > 0.5 ? COL_BRIGHT : COL_MID;
      ctx.fillText(ch, 0, 0);

      ctx.restore();
    });
  }

  var raf;
  function frame(ts) {
    var t = ts * 0.001;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    for (var r = 0; r < RINGS.length; r++) drawRing(RINGS[r], t);
    raf = requestAnimationFrame(frame);
  }
  raf = requestAnimationFrame(frame);

  /* Pause when tab is hidden to save battery */
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) cancelAnimationFrame(raf);
    else raf = requestAnimationFrame(frame);
  });
})();
</script>

{% schema %}
{
  "name": "Jack Hero",
  "tag": "div",
  "class": "jack-hero-section",
  "settings": [
    { "type":"text", "id":"hero_cta_label", "label":"CTA label",    "default":"Explore Now" },
    { "type":"url",  "id":"hero_cta_url",   "label":"CTA link" }
  ],
  "presets": [{ "name":"Jack Hero" }]
}
{% endschema %}
