{%- comment -%}
  sections/video-hero.liquid

  Full-viewport video hero — direct translation of the React/Tailwind spec.
  Design tokens:
    bg:     #f0f0ee      pill bg: #EDEDED
    accent: blue-500 (#3b82f6)  blue-600 (#2563eb)  blue-400 (#60a5fa)
    text:   gray-900 (#111827)  gray-700 (#374151)  gray-400 (#9ca3af)

  ALL styles scoped to #vh-{{ section.id }}.  Zero global bleed.
{%- endcomment -%}

<style>
/* ── Video Hero — fully scoped ──────────────────────────────── */

/* Reset any global theme styles leaking into this section wrapper */
.shopify-section:has(#vh-{{ section.id }}) {
  background: transparent !important;
  margin:     0 !important;
  padding:    0 !important;
}

/* ── Root ───────────────────────────────────────────────────── */
#vh-{{ section.id }} {
  position:         relative;
  min-height:       100vh;
  min-height:       100svh;
  overflow:         hidden;
  background-color: #f0f0ee;
}

/* ── Video background (inset-0 w-full h-full object-cover) ─── */
#vh-{{ section.id }} .vh-video {
  position:   absolute;
  top:        0;
  right:      0;
  bottom:     0;
  left:       0;
  width:      100%;
  height:     100%;
  object-fit: cover;
  z-index:    0;
}

/* ── Foreground (relative z-10 flex flex-col min-h-screen) ─── */
#vh-{{ section.id }} .vh-fg {
  position:       relative;
  z-index:        10;
  display:        flex;
  flex-direction: column;
  min-height:     100vh;
  min-height:     100svh;
}

/* ── Navbar ─────────────────────────────────────────────────── */
#vh-{{ section.id }} .vh-nav {
  display:         flex;
  align-items:     center;
  justify-content: center;
  padding-top:     1rem;       /* pt-4 */
  padding-left:    1rem;       /* px-4 */
  padding-right:   1rem;
  gap:             0.5rem;     /* gap-2 */
}

@media (min-width: 640px) {
  #vh-{{ section.id }} .vh-nav {
    padding-top:   1.5rem;     /* sm:pt-6 */
    padding-left:  2rem;       /* sm:px-8 */
    padding-right: 2rem;
    gap:           0.75rem;    /* sm:gap-3 */
  }
}

/* Circular logo pill */
#vh-{{ section.id }} .vh-logo-pill {
  display:          flex;
  align-items:      center;
  justify-content:  center;
  border-radius:    9999px;
  width:            2.5rem;    /* w-10 */
  height:           2.5rem;    /* h-10 */
  flex-shrink:      0;
  background-color: #EDEDED;
  border:           none;
}

@media (min-width: 640px) {
  #vh-{{ section.id }} .vh-logo-pill {
    width:  2.75rem;           /* sm:w-11 */
    height: 2.75rem;           /* sm:h-11 */
  }
}

/* Links pill */
#vh-{{ section.id }} .vh-links-pill {
  display:          flex;
  align-items:      center;
  gap:              1rem;      /* gap-4 */
  border-radius:    0.75rem;   /* rounded-xl */
  padding:          0.625rem 1rem;  /* py-2.5 px-4 */
  background-color: #EDEDED;
}

@media (min-width: 640px) {
  #vh-{{ section.id }} .vh-links-pill {
    gap:     2.5rem;           /* sm:gap-10 */
    padding: 0.75rem 2rem;     /* sm:py-3 sm:px-8 */
  }
}

/* Nav links */
#vh-{{ section.id }} .vh-link,
#vh-{{ section.id }} .vh-link:visited {
  font-size:       12px;       /* text-[12px] */
  font-weight:     500;        /* font-medium */
  color:           #374151 !important;  /* text-gray-700 */
  text-decoration: none;
  font-family:     -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
  transition:      color 200ms;
  white-space:     nowrap;
}

@media (min-width: 640px) {
  #vh-{{ section.id }} .vh-link,
  #vh-{{ section.id }} .vh-link:visited {
    font-size: 14px;           /* sm:text-[14px] */
  }
}

#vh-{{ section.id }} .vh-link:hover {
  color: #111827 !important;   /* hover:text-gray-900 */
}

/* ── Bottom-left hero content ───────────────────────────────── */
#vh-{{ section.id }} .vh-bottom {
  flex:           1;
  display:        flex;
  align-items:    flex-end;    /* items-end */
  padding-bottom: 2.5rem;      /* pb-10 */
  padding-left:   1.5rem;      /* px-6 */
  padding-right:  1.5rem;
}

@media (min-width: 640px) {
  #vh-{{ section.id }} .vh-bottom {
    padding-bottom: 4rem;      /* sm:pb-16 */
    padding-left:   3rem;      /* sm:px-12 */
    padding-right:  3rem;
  }
}

@media (min-width: 768px) {
  #vh-{{ section.id }} .vh-bottom {
    padding-left:  5rem;       /* md:px-20 */
    padding-right: 5rem;
  }
}

@media (min-width: 1024px) {
  #vh-{{ section.id }} .vh-bottom {
    padding-bottom: 5rem;      /* lg:pb-20 */
    padding-left:   7rem;      /* lg:px-28 */
    padding-right:  7rem;
  }
}

/* Content inner — max-w-xs (320px) */
#vh-{{ section.id }} .vh-inner {
  max-width: 20rem;
}

/* Badge link */
#vh-{{ section.id }} .vh-badge,
#vh-{{ section.id }} .vh-badge:visited {
  display:        inline-flex;
  align-items:    center;
  gap:            0.375rem;   /* gap-1.5 */
  font-size:      11.5px;     /* text-[11.5px] */
  font-weight:    500;
  color:          #3b82f6 !important;  /* text-blue-500 */
  text-decoration: none;
  font-family:    -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
  transition:     color 200ms;
  margin-bottom:  0.75rem;    /* mb-3 */
  display:        block;
}

#vh-{{ section.id }} .vh-badge:hover {
  color: #2563eb !important;  /* hover:text-blue-600 */
}

/* We need inline-flex for the inner wrapping */
#vh-{{ section.id }} .vh-badge-inner {
  display:     inline-flex;
  align-items: center;
  gap:         0.375rem;
}

/* H1 */
#vh-{{ section.id }} .vh-h1 {
  font-size:      1.5rem;     /* text-[1.5rem] */
  line-height:    1.15;       /* leading-[1.15] */
  font-weight:    500;        /* font-medium */
  color:          #111827 !important;  /* text-gray-900 */
  letter-spacing: -0.025em;  /* tracking-tight */
  margin:         0 0 0.75rem 0;  /* mb-3 */
  font-family:    -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
}

@media (min-width: 640px) {
  #vh-{{ section.id }} .vh-h1 {
    font-size: 1.75rem;       /* sm:text-[1.75rem] */
  }
}

/* Subtext */
#vh-{{ section.id }} .vh-sub {
  font-size:   13px;          /* text-[13px] */
  color:       #9ca3af !important;  /* text-gray-400 */
  font-weight: 400;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
  margin:      0 0 0.75rem 0; /* mb-3 */
}

/* CTA button */
#vh-{{ section.id }} .vh-cta,
#vh-{{ section.id }} .vh-cta:visited {
  display:         inline-flex;
  align-items:     center;
  gap:             0.5rem;    /* gap-2 */
  font-size:       13px;      /* text-[13px] */
  font-weight:     500;
  color:           #3b82f6 !important;  /* text-blue-500 */
  border:          1px solid #60a5fa;   /* border-blue-400 */
  border-radius:   9999px;    /* rounded-full */
  padding:         0.625rem 1.25rem;    /* py-2.5 px-5 */
  text-decoration: none;
  font-family:     -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
  transition:      background-color 200ms, color 200ms, border-color 200ms;
}

#vh-{{ section.id }} .vh-cta:hover {
  background-color: #3b82f6 !important;  /* hover:bg-blue-500 */
  color:            #ffffff !important;  /* hover:text-white */
  border-color:     #3b82f6 !important;  /* hover:border-blue-500 */
}

/* Arrow micro-interaction — group-hover:translate-x-0.5 */
#vh-{{ section.id }} .vh-arrow {
  display:    inline-block;
  transition: transform 200ms;
}

#vh-{{ section.id }} .vh-badge:hover .vh-arrow,
#vh-{{ section.id }} .vh-cta:hover   .vh-arrow {
  transform: translateX(2px);
}

/* ── Headline + CTA overlay — pinned to top ─────────────────── */
#vh-{{ section.id }} .vh-center {
  position:        absolute;
  inset:           0;
  z-index:         20;
  display:         flex;
  flex-direction:  column;
  align-items:     center;
  justify-content: flex-start;   /* top-aligned */
  padding:         22vh 1.5rem 0;
  gap:             1.6rem;
  text-align:      center;
  pointer-events:  none;
}

/* Soft white gradient halo — sits behind the text, fades to transparent
   so the video shows through below while the headline always pops */
#vh-{{ section.id }} .vh-center::before {
  content:  '';
  position: absolute;
  top:      0;
  left:     0;
  right:    0;
  height:   72%;
  background: linear-gradient(
    to bottom,
    rgba(255,255,255,0.82) 0%,
    rgba(255,255,255,0.55) 40%,
    transparent            100%
  );
  pointer-events: none;
  z-index:  -1;
}

/* ── Big bold headline ─────────────────────────────────────── */
#vh-{{ section.id }} .vh-headline {
  font-family:    -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
  font-size:      clamp(2.4rem, 8.5vw, 11rem);
  font-weight:    900;
  line-height:    0.92;
  letter-spacing: -0.03em;
  text-transform: uppercase;
  color:          #0a0a0a !important;
  margin:         0;
  pointer-events: none;
  /* Entrance: slide down + fade in */
  animation:      vh-headline-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes vh-headline-in {
  from { opacity: 0; transform: translateY(-28px); }
  to   { opacity: 1; transform: translateY(0);     }
}

@media (max-width: 749px) {
  #vh-{{ section.id }} .vh-center {
    padding-top: 16vh;
  }
}

/* ── Dark CTA button ───────────────────────────────────────── */
#vh-{{ section.id }} .vh-cta-btn,
#vh-{{ section.id }} .vh-cta-btn:visited {
  position:        relative;
  display:         inline-flex;
  align-items:     center;
  gap:             0.55rem;
  padding:         0.65rem 1.6rem;
  background:      #111111;
  color:           #ffffff !important;
  border:          none;
  border-radius:   6px;
  font-family:     -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
  font-size:       12px;
  font-weight:     600;
  letter-spacing:  0.12em;
  text-transform:  uppercase;
  text-decoration: none;
  overflow:        hidden;
  cursor:          pointer;
  pointer-events:  all;
  /* Entrance then idle float */
  animation:       vh-btn-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.5s both,
                   vh-float  3s ease-in-out               1.2s infinite;
  transition:      background 0.25s ease, transform 0.2s ease, box-shadow 0.25s ease;
}

/* Button entrance */
@keyframes vh-btn-in {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0);    }
}

/* Float up/down when idle — draws the eye */
@keyframes vh-float {
  0%, 100% { transform: translateY(0);    box-shadow: 0 4px 20px rgba(0,0,0,0.18); }
  50%       { transform: translateY(-5px); box-shadow: 0 10px 28px rgba(0,0,0,0.22); }
}

/* Hover — pause float, scale up, darken */
#vh-{{ section.id }} .vh-cta-btn:hover {
  background:       #2a2a2a !important;
  animation-play-state: paused;
  transform:        translateY(-2px) scale(1.03) !important;
  box-shadow:       0 8px 32px rgba(0,0,0,0.28) !important;
}

/* Shimmer sweep on hover (::before pseudo-element) */
#vh-{{ section.id }} .vh-cta-btn::before {
  content:    '';
  position:   absolute;
  top:        0;
  left:       -75%;
  width:      50%;
  height:     100%;
  background: linear-gradient(
    105deg,
    transparent 20%,
    rgba(255,255,255,0.18) 50%,
    transparent 80%
  );
  transform:  skewX(-15deg);
  transition: left 0s;
}

#vh-{{ section.id }} .vh-cta-btn:hover::before {
  left:       130%;
  transition: left 0.55s ease;
}

/* Arrow nudge on hover */
#vh-{{ section.id }} .vh-cta-btn .vh-btn-arrow {
  display:    inline-block;
  transition: transform 0.22s ease;
}

#vh-{{ section.id }} .vh-cta-btn:hover .vh-btn-arrow {
  transform: translateX(3px);
}
</style>

<div id="vh-{{ section.id }}">

  {%- if section.settings.video_url != blank -%}
    <video
      class="vh-video"
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
    >
      <source src="{{ section.settings.video_url }}" type="video/mp4">
    </video>
  {%- endif -%}

  <div class="vh-fg">

    <!-- Centered headline + CTA -->
    <div class="vh-center">
      <h1 class="vh-headline">{{ section.settings.headline | default: 'Innovations That Make Life Easier' }}</h1>
      <a href="{{ section.settings.hero_cta_url | default: 'shopify://collections/all' }}" class="vh-cta-btn">
        {{- section.settings.hero_cta_label | default: 'Explore Now' -}}
        <span class="vh-btn-arrow" aria-hidden="true">&#8594;</span>
      </a>
    </div>

  </div>
</div>

