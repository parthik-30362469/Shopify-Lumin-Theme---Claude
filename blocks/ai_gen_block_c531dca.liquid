{% doc %}
  @prompt
    I want to create a video play carousel for atleast 4 videos. the videos should not be huge but like thumbnail review types., add more margin between video carousel section and other sections
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-carousel-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
    position: relative;
    overflow: hidden;
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
        background-color: #FFFFFF;
    padding: 20px 0;
  }

  .ai-video-carousel__heading-{{ ai_gen_id }} {
    text-align: center;
    color: #000000;
    font-size: 28px;
    font-weight: 700;
    margin: 0 0 20px 0;
    padding: 0 20px;
  }

  .ai-video-carousel__container-{{ ai_gen_id }} {
    position: relative;
    padding: 0 50px;
  }

  .ai-video-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.video_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
     justify-content: center;
  }

  .ai-video-carousel__track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-video-carousel__item-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.video_width }}px;
    position: relative;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
    background-color: #FFFFFF;
  }

  .ai-video-carousel__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.video_height }}px;
    16
    : #000000;
  }

  .ai-video-carousel__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-carousel__play-button-{{ ai_gen_id }} {
   display: none !important;
  }

  .ai-video-carousel__play-button-{{ ai_gen_id }}:hover {
    transform: translate(-50%, -50%) scale(1.1);
    opacity: 1;
  }

  .ai-video-carousel__play-button-{{ ai_gen_id }}.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .ai-video-carousel__play-button-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    fill: {{ block.settings.play_button_icon_color }};
    margin-left: 3px;
  }

  .ai-video-carousel__caption-{{ ai_gen_id }} {
    padding: 12px;
    background-color: {{ block.settings.caption_bg_color }};
    color: {{ block.settings.caption_text_color }};
    font-size: {{ block.settings.caption_font_size }}px;
    text-align: center;
  }

  .ai-video-carousel__nav-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    background-color: {{ block.settings.nav_button_color }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background-color 0.3s ease;
  }

  .ai-video-carousel__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_color }};
  }

  .ai-video-carousel__nav-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    fill: {{ block.settings.nav_button_icon_color }};
  }

  .ai-video-carousel__nav-button--prev-{{ ai_gen_id }} {
    left: 0;
  }

  .ai-video-carousel__nav-button--next-{{ ai_gen_id }} {
    right: 0;
  }

  .ai-video-carousel__empty-state-{{ ai_gen_id }} {
    padding: 40px;
    text-align: center;
    color: #666;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-video-carousel-{{ ai_gen_id }} {
      margin-top: {{ block.settings.margin_top_mobile }}px;
      margin-bottom: {{ block.settings.margin_bottom_mobile }}px;
    }

    .ai-video-carousel__container-{{ ai_gen_id }} {
      padding: 0 40px;
    }

    .ai-video-carousel__item-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.video_width_mobile }}px;
    }

    .ai-video-carousel__video-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.video_height_mobile }}px;
    }

    .ai-video-carousel__nav-button-{{ ai_gen_id }} {
      width: 32px;
      height: 32px;
    }

    .ai-video-carousel__play-button-{{ ai_gen_id }} {
      width: 48px;
      height: 48px;
    }

    .ai-video-carousel__play-button-{{ ai_gen_id }} svg {
      width: 20px;
      height: 20px;
    }
  }
{% endstyle %}

<video-carousel-{{ ai_gen_id }} class="ai-video-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% assign has_videos = false %}
  {% for i in (1..6) %}
    {% assign video_key = 'video_' | append: i %}
    {% if block.settings[video_key] != blank %}
      {% assign has_videos = true %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% if has_videos %}
   <h2 class="ai-video-carousel__heading-{{ ai_gen_id }}">Stories Worth Sharing</h2>
    <div class="ai-video-carousel__container-{{ ai_gen_id }}">
      <button
        class="ai-video-carousel__nav-button-{{ ai_gen_id }} ai-video-carousel__nav-button--prev-{{ ai_gen_id }}"
        aria-label="Previous video"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
        </svg>
      </button>

      <div class="ai-video-carousel__track-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% assign video_key = 'video_' | append: i %}
          {% assign caption_key = 'video_' | append: i | append: '_caption' %}
          {% assign video = block.settings[video_key] %}
          {% assign caption = block.settings[caption_key] %}

          {% if video != blank %}
            <div class="ai-video-carousel__item-{{ ai_gen_id }}" data-video-index="{{ i }}">
              <div class="ai-video-carousel__video-wrapper-{{ ai_gen_id }}">
                {% if video.sources[1].url %}
                  <video
                     class="ai-video-carousel__video-{{ ai_gen_id }}"
                     preload="metadata"
                     playsinline
                     autoplay
                     loop
                     muted
                  >
                    <source src="{{ video.sources[1].url }}" type="{{ video.sources[1].mime_type }}">
                  </video>
                {% endif %}
                <button
                  class="ai-video-carousel__play-button-{{ ai_gen_id }}"
                  aria-label="Play video"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </button>
              </div>
              {% if caption != blank %}
                <div class="ai-video-carousel__caption-{{ ai_gen_id }}">
                  {{ caption }}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <button
        class="ai-video-carousel__nav-button-{{ ai_gen_id }} ai-video-carousel__nav-button--next-{{ ai_gen_id }}"
        aria-label="Next video"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
        </svg>
      </button>
    </div>
  {% else %}
    <div class="ai-video-carousel__empty-state-{{ ai_gen_id }}">
      Next, add videos to the carousel
    </div>
  {% endif %}
</video-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentVideoPlaying = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-video-carousel__track-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-video-carousel__nav-button--prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-video-carousel__nav-button--next-{{ ai_gen_id }}');
        this.items = this.querySelectorAll('.ai-video-carousel__item-{{ ai_gen_id }}');
        this.playButtons = this.querySelectorAll('.ai-video-carousel__play-button-{{ ai_gen_id }}');
        this.videos = this.querySelectorAll('.ai-video-carousel__video-{{ ai_gen_id }}');

        if (this.track && this.prevButton && this.nextButton) {
          this.setupNavigation();
          this.setupVideoControls();
        }
      }

      setupNavigation() {
        this.prevButton.addEventListener('click', () => {
          const scrollAmount = this.items[0].offsetWidth + {{ block.settings.video_gap }};
          this.track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        });

        this.nextButton.addEventListener('click', () => {
          const scrollAmount = this.items[0].offsetWidth + {{ block.settings.video_gap }};
          this.track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        });
      }

      setupVideoControls() {
        this.playButtons.forEach((button, index) => {
          const video = this.videos[index];
          
          button.addEventListener('click', () => {
            if (this.currentVideoPlaying && this.currentVideoPlaying !== video) {
              this.currentVideoPlaying.pause();
              this.currentVideoPlaying.currentTime = 0;
              const prevButton = this.currentVideoPlaying.parentElement.querySelector('.ai-video-carousel__play-button-{{ ai_gen_id }}');
              if (prevButton) {
                prevButton.classList.remove('hidden');
              }
            }

            if (video.paused) {
              video.play();
              button.classList.add('hidden');
              this.currentVideoPlaying = video;
            } else {
              video.pause();
              button.classList.remove('hidden');
            }
          });

          video.addEventListener('ended', () => {
            button.classList.remove('hidden');
            this.currentVideoPlaying = null;
          });

          video.addEventListener('click', () => {
            if (!video.paused) {
              video.pause();
              button.classList.remove('hidden');
            }
          });
        });
      }
    }

    customElements.define('video-carousel-{{ ai_gen_id }}', VideoCarousel{{ ai_gen_id }});
  })();
</script>

