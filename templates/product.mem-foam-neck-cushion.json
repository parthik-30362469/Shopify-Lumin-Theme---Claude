    "faqs_5p00iw": {
      "type": "pp-faqs-v1-0-0",
      "blocks": {
        "faq_item_Fk6p7D": {
          "type": "faq_item",
          "settings": {
            "question": "Is it suitable on sensitive skin?",
            "answer": "KOEC is formulated with lightweight, skin-loving ingredients designed to feel gentle and comfortable on the skin. Many customers with dry, combination, and sensitive-feeling skin enjoy the nourishing yet non-heavy texture. However, because every skin type is unique, we always recommend patch testing before full use and reviewing the ingredient list if you have known sensitivities or allergies."
          }
        },
        "faq_fs34a2": {
          "type": "faq_item",
          "settings": {
            "question": "Will this feel greasy or heavy on my skin?",
            "answer": "No — KOEC is designed with a lightweight capsule-in-gel texture that absorbs comfortably into the skin while still delivering deep hydration and glow without a sticky or oily finish."
          }
        },
        "faq_pfugaw": {
          "type": "faq_item",
          "settings": {
            "question": "Can I wear this under makeup?",
            "answer": "Yes. The smooth, lightweight formula layers beautifully under makeup and helps create a more hydrated, fresh-looking base without heavy buildup or pilling."
          }
        },
        "faq_ait9mr": {
          "type": "faq_item",
          "settings": {
            "question": "Is it suitable for all skin types?",
            "answer": "KOEC is designed for dry, combination, normal, and oily skin types. The customisable capsule-to-gel ratio allows you to adjust the texture based on your skin’s needs."
          }
        },
        "faq_r2pass": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use it both morning and night?",
            "answer": "Absolutely. KOEC can be used as part of both your morning and evening skincare routine to help maintain hydration, glow, and smoother-looking skin throughout the day."
          }
        },
        "faq_0wqokg": {
          "type": "faq_item",
          "settings": {
            "question": "What skin concerns does it help with?",
            "answer": "KOEC helps improve the appearance of dullness, dryness, uneven texture, tired-looking skin, and fine lines while supporting a softer-, brighter-, and more radiant-looking complexion."
          }
        }
      },
