    "faqs_ofbkh9": {
      "type": "pp-faqs-v1-0-0",
      "blocks": {
        "faq_orqpia": {
          "type": "faq_item",
          "settings": {
            "question": "How do I set up the fly trap bag?",
            "answer": "Fill the bait pouch with the recommended sugar water, hang the bag using the included rope in an open area away from doors, and let the attractant dissolve and work. Setup takes minutes."
          }
        },
        "faq_cnomxx": {
          "type": "faq_item",
          "settings": {
            "question": "Is the bait safe around pets and livestock?",
            "answer": "Yes. The trap is non-toxic and chemical-free. Hang it where animals won’t directly access it for extra safety and peace of mind."
          }
        },
        "faq_zin2n5": {
          "type": "faq_item",
          "settings": {
            "question": "How long does one trap last?",
            "answer": "Duration depends on fly pressure and weather, but typical use lasts several weeks. Replace when the bag is full or bait is spent for consistent results."
          }
        },
        "faq_tpmv7h": {
          "type": "faq_item",
          "settings": {
            "question": "Will it make my yard smell?",
            "answer": "The attractant is designed to lure flies without strong offensive odors. Proper placement outdoors prevents noticeable smells in living spaces."
          }
        },
        "faq_aoxoqz": {
          "type": "faq_item",
          "settings": {
            "question": "Is cleanup difficult after use?",
            "answer": "No. The disposable bag seals captured insects inside. Remove and discard the bag—no sticky paper or handling dead flies required."
          }
        }
      },
