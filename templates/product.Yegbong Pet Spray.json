type":"faq_item","settings":{"question":"How long before I see results?","answer":"Many users see visible stain reduction and odor improvement within minutes. Deep or years-old stains may require additional applications for best results."}}},"block_order":["faq_qur7cw","faq_fb08es","faq_u0lrct","faq_5yg56i","faq_25xi3n"],"settings":{"heading":"Common Questions About Yegbong Pet Spray","description":"Clear answers to help you clean with confidence and get the best results.","desktop_content_alignment":"center","mobile_content_alignment":"center","button_behaviour":"scroll_to_top","button_label":"","button_link":"","faqitem_background":"linear-gradient(180deg, rgba(213, 230, 246, 1), rgba(213, 230, 246, 1) 49%, rgba(213, 230, 246, 1) 100%)","section_background":"","padding_top":30,"padding_bottom":30,"padding_top_mobile":30,"padding_bottom_mobile":30,"margin_top":0,"margin_bottom":0,"margin_top_mobile":0,"margin_bottom_mobile":0}},"section_divider_TyDzL8":{"type":"section-divider","name":"Section divider","settings":{"visibility":"always-display","shape":"waves_3","flip_horizontal":false,"flip_vertical":false,"shape_color":"","use_custom_shape_color":true,"custom_shape_color":"#d5e6f6","background_color":"background-1","use_custom_background_color":false,"custom_background_color":"#ffffff","padding_top":0,"padding_bottom":0}},"pp_image_with_text_v1_0_0_xXa4gL":{"type":"pp-image-with-text-v1-0-0","blocks":{"heading_wWnG4r":{"type":"heading","settings":{"heading":"Over 1500+ happy pet owners"}},"text_qiiCex":{"type":"text","settings":{"text":"Join thousands who've transformed their homes with yegbong Pet Spray. From stubborn carpet stains to lingering pet odors, customers love how quickly and effortlessly it restores a fresh, clean space without harsh chemicals or constant re-cleaning."}}},"block_order":["heading_wWnG4r","text_qiiCex"],"name":"PP Image with Text","settings":{"image":"shopify:\/\/shop_images\/Copy_of_CANVA_TEMPLATES_ENG_d4fd9910-876f-4e50-a7d8-7a267d1546